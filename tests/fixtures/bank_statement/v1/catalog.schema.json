        "pdfSha256",
        "expectedResultPath",
        "expectedResultSha256",
        "byteSize",
        "pageCount",
        "expectedLifecycle",
        "expectedCurrentStage",
        "expectedStageState",
        "manualReviewChecklist"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": [
            "scanalyze.fixture-catalog.v1"
          ]
        },
        "fixtureId": {
          "type": "string"
        },
        "fixtureVersion": {
          "type": "string"
        },
        "profileId": {
          "type": "string"
        },
        "instanceId": {
          "type": "string"
        },
        "scenarioType": {
          "type": "string"
        },
        "positiveOrNegative": {
          "const": "POSITIVE"
        },
        "mimeType": {
          "type": "string"
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "SYNTHETIC"
          ]
        },
        "sourceSpecPath": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.).*$"
        },
        "sourceSpecSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generatorPath": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.).*$"
        },
        "generatorVersion": {
          "type": "string"
        },
        "generatorSourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "acceptedDocumentDenominator": {
          "const": true
        },
        "retentionClass": {
          "type": "string"
        },
        "noRealDataAttestation": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variant": {
          "const": "positiveFixture"
        },
        "filePath": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.).*$"
        },
        "expectedResultPath": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.).*$"
        },
        "expectedLifecycle": {
          "type": "string",
          "enum": [
            "UPLOAD_PENDING",
            "SUBMITTED",
            "PROCESSING",
            "COMPLETED",
            "FAILED"
          ]
        },
        "expectedCurrentStage": {
          "type": "string",
          "enum": [
            "TERMINAL"
          ]
        },
        "expectedStageState": {
          "type": "string",
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "expectedHttpStatus": {
          "type": "integer"
        },
        "expectedErrorCode": {
          "type": "string"
        },
        "expectedSafeFailureCode": {
          "type": "string"
        },
        "expectedRetryClass": {
          "type": "string",
          "enum": [
            "NOT_RETRYABLE",
            "RETRYABLE_WITH_BACKOFF",
            "RETRY_ONLY_AFTER_RECONCILIATION",
            "TERMINAL",
            "UNKNOWN_OR_QUARANTINED"
