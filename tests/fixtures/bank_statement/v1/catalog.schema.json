    "positiveFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "fixtureId",
        "fixtureVersion",
        "profileId",
        "instanceId",
        "scenarioType",
        "positiveOrNegative",
        "mimeType",
        "sensitivity",
        "sourceSpecPath",
        "sourceSpecSha256",
        "generatorPath",
