{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scanalyze.fixture-catalog.v1.schema.json",
  "title": "Scanalyze Fixture Catalog Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtures"
  ],
  "properties": {
    "fixtures": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/positiveFixture"
          },
          {
            "$ref": "#/$defs/physicalPayloadControl"
          },
          {
            "$ref": "#/$defs/localDemoPolicyControl"
          },
          {
            "$ref": "#/$defs/documentTerminalFailureControl"
          },
          {
            "$ref": "#/$defs/requestConflictControl"
          },
          {
            "$ref": "#/$defs/reconciliationControl"
          },
          {
            "$ref": "#/$defs/authorizationControl"
          }
        ]
      }
    }
  },
