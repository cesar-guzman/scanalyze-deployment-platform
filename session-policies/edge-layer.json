{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RestrictSSMWriteToLayerPrefix",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:AddTagsToResource"
      ],
      "Resource": "arn:${aws_partition}:ssm:${region}:${account_id}:parameter/scanalyze/deployments/${deployment_id}/contracts/edge/*"
    },
    {
      "Sid": "ManageExactFrontendRuntimeConfig",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:${aws_partition}:s3:::scanalyze-${account_id}-frontend/${deployment_id}/config.json"
    },
    {
      "Sid": "DenySSMWriteOutsideLayer",
      "Effect": "Deny",
      "Action": [
        "ssm:PutParameter",
        "ssm:DeleteParameter"
      ],
      "NotResource": "arn:${aws_partition}:ssm:${region}:${account_id}:parameter/scanalyze/deployments/${deployment_id}/contracts/edge/*"
    }
  ]
}
