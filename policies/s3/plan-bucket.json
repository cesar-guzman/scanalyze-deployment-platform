{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNonTLS",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::scanalyze-${account_id}-tf-plan",
        "arn:aws:s3:::scanalyze-${account_id}-tf-plan/*"
      ],
      "Principal": "*",
      "Condition": {
        "Bool": { "aws:SecureTransport": "false" }
      }
    },
    {
      "Sid": "AllowPlanWriteExactExecution",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::scanalyze-${account_id}-tf-plan/plan-execution/${deployment_id}/${aws:PrincipalTag/change_id}/${aws:PrincipalTag/layer}/plan.tfplan",
      "Principal": {
        "AWS": [
          "arn:aws:iam::${account_id}:role/ScanalyzeCustomer-Plan",
          "arn:aws:iam::${account_id}:role/ScanalyzeCustomer-Identity-Plan"
        ]
      },
      "Condition": {
        "StringEquals": { "aws:PrincipalTag/operation": "plan" }
      }
    },
    {
      "Sid": "AllowApplyReadExactExecutionVersion",
      "Effect": "Allow",
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:aws:s3:::scanalyze-${account_id}-tf-plan/plan-execution/${deployment_id}/${aws:PrincipalTag/change_id}/${aws:PrincipalTag/layer}/plan.tfplan",
      "Principal": {
        "AWS": [
          "arn:aws:iam::${account_id}:role/ScanalyzeCustomer-Apply",
          "arn:aws:iam::${account_id}:role/ScanalyzeCustomer-Identity-Apply"
        ]
      },
      "Condition": {
        "StringEquals": { "aws:PrincipalTag/operation": "apply" }
      }
    }
  ]
}
