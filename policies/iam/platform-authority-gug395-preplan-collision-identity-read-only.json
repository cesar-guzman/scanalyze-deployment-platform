{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConfirmOnlyTheCurrentCaller",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*",
      "Condition": {
        "DateGreaterThanEquals": {
          "aws:CurrentTime": "${inventory_not_before}"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${inventory_not_after}"
        }
      }
    },
    {
      "Sid": "DiscoverUnscopedIdentityCenterCollisionCandidates",
      "Effect": "Allow",
      "Action": [
        "sso:ListApplications",
        "sso:ListInstances"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "DateGreaterThanEquals": {
          "aws:CurrentTime": "${inventory_not_before}"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${inventory_not_after}"
        }
      }
    },
    {
      "Sid": "DiscoverPrimaryRegionPermissionSetCandidates",
      "Effect": "Allow",
      "Action": "sso:ListPermissionSets",
      "Resource": "${identity_center_instance_arn}",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "sso:PrimaryRegion": "us-east-1"
        },
        "DateGreaterThanEquals": {
          "aws:CurrentTime": "${inventory_not_before}"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${inventory_not_after}"
        }
      }
    },
    {
      "Sid": "DescribePrimaryRegionIdentityCenterCandidates",
      "Effect": "Allow",
      "Action": [
        "sso:DescribeApplication",
        "sso:DescribePermissionSet"
      ],
      "Resource": [
        "${identity_center_instance_arn}",
        "arn:aws:sso::${management_account_id}:application/*",
        "arn:aws:sso:::permissionSet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "sso:PrimaryRegion": "us-east-1"
        },
        "DateGreaterThanEquals": {
          "aws:CurrentTime": "${inventory_not_before}"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${inventory_not_after}"
        }
      }
    },
    {
      "Sid": "ReadOnlyIdentityCenterCandidateTags",
      "Effect": "Allow",
      "Action": "sso:ListTagsForResource",
      "Resource": [
        "${identity_center_instance_arn}",
        "arn:aws:sso::${management_account_id}:application/*",
        "arn:aws:sso:::permissionSet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "DateGreaterThanEquals": {
          "aws:CurrentTime": "${inventory_not_before}"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${inventory_not_after}"
        }
      }
    },
    {
      "Sid": "DecryptCollisionMetadataThroughIdentityCenter",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "${identity_center_kms_key_arn}",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "kms:CallerAccount": "${management_account_id}",
          "kms:ViaService": "sso.us-east-1.amazonaws.com"
        },
        "StringLike": {
          "kms:EncryptionContext:aws:sso:instance-arn": "${identity_center_instance_arn}"
        },
        "DateGreaterThanEquals": {
          "aws:CurrentTime": "${inventory_not_before}"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${inventory_not_after}"
        }
      }
    },
    {
      "Sid": "DenyIdentityReadsOutsideHomeRegion",
      "Effect": "Deny",
      "Action": "sso:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenyAllActionsBeforeAbsoluteStart",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${inventory_not_before}"
        }
      }
    },
    {
      "Sid": "DenyAllActionsAtAbsoluteExpiry",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "DateGreaterThanEquals": {
          "aws:CurrentTime": "${inventory_not_after}"
        }
      }
    },
    {
      "Sid": "DenyEveryUnreviewedAction",
      "Effect": "Deny",
      "NotAction": [
        "sso:DescribeApplication",
        "sso:DescribePermissionSet",
        "sso:ListApplications",
        "sso:ListInstances",
        "sso:ListPermissionSets",
        "sso:ListTagsForResource",
        "kms:Decrypt",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
