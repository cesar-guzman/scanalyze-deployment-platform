{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListIdentityState",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-state",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/operation": "apply",
          "aws:PrincipalTag/layer": "identity-control-plane"
        },
        "StringLike": {
          "s3:prefix": [
            "${deployment_id}/${region}/identity-control-plane/terraform.tfstate",
            "${deployment_id}/${region}/identity-control-plane/terraform.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Sid": "ReadWriteIdentityLayerState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-state/${deployment_id}/${region}/identity-control-plane/terraform.tfstate"
    },
    {
      "Sid": "ManageIdentityLayerLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-state/${deployment_id}/${region}/identity-control-plane/terraform.tfstate.tflock"
    },
    {
      "Sid": "ReadIdentityPlanExecutionZone",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-state/plan-execution/${deployment_id}/${aws:PrincipalTag/change_id}/identity-control-plane/plan.tfplan",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/operation": "apply",
          "aws:PrincipalTag/layer": "identity-control-plane"
        }
      }
    },
    {
      "Sid": "ReadSavedPlanKey",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:${aws_partition}:kms:${region}:${account_id}:key/${state_kms_key_id}"
    },
    {
      "Sid": "ReadApprovedArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:${aws_partition}:s3:::scanalyze-shared-releases/*"
    },
    {
      "Sid": "PublishIdentityContract",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:PutParameter"
      ],
      "Resource": [
        "arn:${aws_partition}:s3:::scanalyze-${account_id}-contracts/${deployment_id}/identity-control-plane/*",
        "arn:${aws_partition}:ssm:${region}:${account_id}:parameter/scanalyze/deployments/${deployment_id}/contracts/identity-control-plane/*"
      ]
    },
    {
      "Sid": "ReadPreprovisionedIdentityUserPool",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPool",
        "cognito-idp:GetGroup",
        "cognito-idp:ListGroups"
      ],
      "Resource": "arn:${aws_partition}:cognito-idp:${region}:${account_id}:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/customer_id": "${customer_id}",
          "aws:ResourceTag/deployment_id": "${deployment_id}",
          "aws:ResourceTag/layer": "identity-control-plane"
        }
      }
    },
    {
      "Sid": "ManageIdentityFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateAlias",
        "lambda:CreateFunction",
        "lambda:GetAlias",
        "lambda:GetFunction",
        "lambda:GetPolicy",
        "lambda:ListVersionsByFunction",
        "lambda:PublishVersion",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateAlias",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": [
        "arn:${aws_partition}:lambda:${region}:${account_id}:function:${deployment_id}-identity-pre-token",
        "arn:${aws_partition}:lambda:${region}:${account_id}:function:${deployment_id}-identity-pre-token:*",
        "arn:${aws_partition}:lambda:${region}:${account_id}:function:${deployment_id}-identity-control-processor",
        "arn:${aws_partition}:lambda:${region}:${account_id}:function:${deployment_id}-identity-control-processor:*"
      ]
    },
    {
      "Sid": "ManageIdentityStores",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:UpdateTable",
        "dynamodb:UpdateTimeToLive"
      ],
      "Resource": "arn:${aws_partition}:dynamodb:${region}:${account_id}:table/${deployment_id}-identity-*"
    },
    {
      "Sid": "ManageIdentityQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueueTags",
        "sqs:TagQueue",
        "sqs:UntagQueue"
      ],
      "Resource": "arn:${aws_partition}:sqs:${region}:${account_id}:${deployment_id}-identity-*"
    },
    {
      "Sid": "ReadPreprovisionedIdentityRuntimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy"
      ],
      "Resource": [
        "arn:${aws_partition}:iam::${account_id}:role/scanalyze/${deployment_id}/identity-${deployment_id}-pre-token",
        "arn:${aws_partition}:iam::${account_id}:role/scanalyze/${deployment_id}/identity-${deployment_id}-control-processor"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/customer_id": "${customer_id}",
          "aws:ResourceTag/deployment_id": "${deployment_id}",
          "aws:ResourceTag/layer": "identity-control-plane"
        }
      }
    },
    {
      "Sid": "PassPreTokenRoleToFunction",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:${aws_partition}:iam::${account_id}:role/scanalyze/${deployment_id}/identity-${deployment_id}-pre-token",
      "Condition": {
        "StringEquals": {"iam:PassedToService": "lambda.${aws_url_suffix}"},
        "ArnLike": {"iam:AssociatedResourceArn": "arn:${aws_partition}:lambda:${region}:${account_id}:function:${deployment_id}-identity-pre-token"}
      }
    },
    {
      "Sid": "PassControlProcessorRoleToFunction",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:${aws_partition}:iam::${account_id}:role/scanalyze/${deployment_id}/identity-${deployment_id}-control-processor",
      "Condition": {
        "StringEquals": {"iam:PassedToService": "lambda.${aws_url_suffix}"},
        "ArnLike": {"iam:AssociatedResourceArn": "arn:${aws_partition}:lambda:${region}:${account_id}:function:${deployment_id}-identity-control-processor"}
      }
    },
    {
      "Sid": "DescribeIdentityMonitoring",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DescribeAlarms",
        "logs:DescribeLogGroups",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/operation": "apply",
          "aws:PrincipalTag/layer": "identity-control-plane"
        }
      }
    },
    {
      "Sid": "TagPreprovisionedIdentityAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListTagsForResource",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource"
      ],
      "Resource": "arn:${aws_partition}:cloudwatch:${region}:${account_id}:alarm:${deployment_id}-identity-*"
    },
    {
      "Sid": "ManageIdentityLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:AssociateKmsKey",
        "logs:CreateLogGroup",
        "logs:ListTagsForResource",
        "logs:PutMetricFilter",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": "arn:${aws_partition}:logs:${region}:${account_id}:log-group:/aws/lambda/${deployment_id}-identity-*"
    },
    {
      "Sid": "ManageTaggedIdentityEncryptionKey",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:EnableKeyRotation",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListResourceTags"
      ],
      "Resource": "arn:${aws_partition}:kms:${region}:${account_id}:key/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/customer_id": "${customer_id}",
          "aws:ResourceTag/deployment_id": "${deployment_id}",
          "aws:ResourceTag/layer": "identity-control-plane"
        }
      }
    },
    {
      "Sid": "TagBoundIdentityEncryptionKey",
      "Effect": "Allow",
      "Action": "kms:TagResource",
      "Resource": "arn:${aws_partition}:kms:${region}:${account_id}:key/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/customer_id": "${customer_id}",
          "aws:ResourceTag/deployment_id": "${deployment_id}",
          "aws:ResourceTag/layer": "identity-control-plane",
          "aws:RequestTag/customer_id": "${customer_id}",
          "aws:RequestTag/deployment_id": "${deployment_id}",
          "aws:RequestTag/layer": "identity-control-plane"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["customer_id", "deployment_id", "layer"]
        }
      }
    },
    {
      "Sid": "CreateBoundIdentityEncryptionGrant",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "arn:${aws_partition}:kms:${region}:${account_id}:key/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/customer_id": "${customer_id}",
          "aws:ResourceTag/deployment_id": "${deployment_id}",
          "aws:ResourceTag/layer": "identity-control-plane"
        },
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        },
        "ForAllValues:StringEquals": {
          "kms:GrantOperations": [
            "Decrypt",
            "DescribeKey",
            "Encrypt",
            "GenerateDataKey",
            "GenerateDataKeyWithoutPlaintext"
          ]
        }
      }
    },
    {
      "Sid": "ManageExactIdentityEncryptionAlias",
      "Effect": "Allow",
      "Action": [
        "kms:CreateAlias",
        "kms:UpdateAlias"
      ],
      "Resource": "arn:${aws_partition}:kms:${region}:${account_id}:alias/${deployment_id}-identity"
    },
    {
      "Sid": "BindIdentityAliasToOwnedKey",
      "Effect": "Allow",
      "Action": [
        "kms:CreateAlias",
        "kms:UpdateAlias"
      ],
      "Resource": "arn:${aws_partition}:kms:${region}:${account_id}:key/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/customer_id": "${customer_id}",
          "aws:ResourceTag/deployment_id": "${deployment_id}",
          "aws:ResourceTag/layer": "identity-control-plane"
        }
      }
    },
    {
      "Sid": "UseDeploymentInfrastructureEncryptionKeys",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": [
        "arn:${aws_partition}:kms:${region}:${account_id}:key/${state_kms_key_id}",
        "arn:${aws_partition}:kms:${region}:${account_id}:key/${contracts_kms_key_id}"
      ]
    },
    {
      "Sid": "DenyIdentityDestructionOutsideReviewedDecommission",
      "Effect": "Deny",
      "Action": [
        "cloudwatch:DeleteAlarms",
        "cognito-idp:DeleteGroup",
        "cognito-idp:DeleteResourceServer",
        "cognito-idp:DeleteUserPool",
        "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:DeleteUserPoolDomain",
        "dynamodb:DeleteTable",
        "iam:DeletePolicy",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "kms:DeleteAlias",
        "kms:DisableKey",
        "kms:ScheduleKeyDeletion",
        "lambda:DeleteAlias",
        "lambda:DeleteFunction",
        "lambda:RemovePermission",
        "logs:DeleteLogGroup",
        "logs:DeleteMetricFilter",
        "logs:DeleteRetentionPolicy",
        "secretsmanager:DeleteSecret",
        "sqs:DeleteQueue",
        "sqs:PurgeQueue"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyRemovalOfIdentityBindingTags",
      "Effect": "Deny",
      "Action": [
        "cognito-idp:UntagResource",
        "kms:UntagResource"
      ],
      "Resource": [
        "arn:${aws_partition}:cognito-idp:${region}:${account_id}:userpool/*",
        "arn:${aws_partition}:kms:${region}:${account_id}:key/*"
      ],
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "customer_id",
            "deployment_id",
            "layer"
          ]
        }
      }
    },
    {
      "Sid": "DenyPrivilegeEscalationAndHumanAdministration",
      "Effect": "Deny",
      "Action": [
        "cognito-idp:AdminCreateUser",
        "cognito-idp:AdminSetUserPassword",
        "iam:AttachRolePolicy",
        "iam:CreateAccessKey",
        "iam:CreateUser",
        "iam:DeleteRolePermissionsBoundary",
        "iam:PutRolePermissionsBoundary",
        "iam:PutUserPolicy",
        "organizations:*"
      ],
      "Resource": "*"
    }
  ]
}
