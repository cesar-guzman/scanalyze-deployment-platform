{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "${ledger_factory_role_arn}",
      "Condition": {
        "StringEquals": {"iam:PassedToService": "lambda.amazonaws.com"},
        "ArnEquals": {"iam:AssociatedResourceArn": "${ledger_factory_function_arn}"}
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListEntitiesForPolicy",
        "iam:ListPolicyVersions",
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:ListRoleTags"
      ],
      "Resource": [
        "${proof_boundary_arn}",
        "${ledger_factory_role_arn}"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObjectVersion",
      "Resource": "${ledger_factory_signed_object_arn}",
      "Condition": {
        "StringEquals": {
          "s3:VersionId": "${ledger_factory_signed_version_id}",
          "s3:ResourceAccount": "${authority_account_id}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "${ledger_factory_signed_kms_key_arn}",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "${authority_account_id}",
          "kms:ViaService": "s3.${region}.amazonaws.com",
          "kms:EncryptionContext:aws:s3:arn": [
            "${ledger_factory_signed_object_arn}",
            "${ledger_factory_signed_bucket_arn}"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "lambda:CreateFunction",
      "Resource": "${ledger_factory_function_arn}",
      "Condition": {
        "ArnEquals": {"lambda:CodeSigningConfigArn": "${ledger_factory_code_signing_config_arn}"},
        "StringEquals": {
          "aws:RequestTag/managed_by": "reviewed-direct-lambda",
          "aws:RequestTag/service": "scanalyze-platform-authority",
          "aws:RequestTag/work_package": "GUG-365",
          "aws:RequestTag/environment": "non-production",
          "aws:RequestTag/production": "false",
          "aws:RequestTag/source_commit": "${source_commit}",
          "aws:RequestTag/gug363_pre_function_binding_sha256": "${gug363_pre_function_binding_sha256}"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "managed_by",
            "service",
            "work_package",
            "environment",
            "production",
            "source_commit",
            "gug363_pre_function_binding_sha256"
          ]
        },
        "Null": {
          "lambda:Layer": "true",
          "lambda:VpcIds": "true",
          "lambda:SubnetIds": "true",
          "lambda:SecurityGroupIds": "true"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "lambda:TagResource",
      "Resource": "${ledger_factory_function_arn}",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/managed_by": "reviewed-direct-lambda",
          "aws:RequestTag/service": "scanalyze-platform-authority",
          "aws:RequestTag/work_package": "GUG-365",
          "aws:RequestTag/environment": "non-production",
          "aws:RequestTag/production": "false",
          "aws:RequestTag/source_commit": "${source_commit}",
          "aws:RequestTag/gug363_pre_function_binding_sha256": "${gug363_pre_function_binding_sha256}"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "managed_by",
            "service",
            "work_package",
            "environment",
            "production",
            "source_commit",
            "gug363_pre_function_binding_sha256"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:PutFunctionConcurrency",
        "lambda:PutRuntimeManagementConfig",
        "lambda:GetFunction",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:GetRuntimeManagementConfig",
        "lambda:ListAliases",
        "lambda:ListFunctionUrlConfigs",
        "lambda:ListTags",
        "lambda:ListVersionsByFunction",
        "lambda:GetCodeSigningConfig"
      ],
      "Resource": [
        "${ledger_factory_function_arn}",
        "${ledger_factory_function_version_arn}",
        "${ledger_factory_code_signing_config_arn}"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:TagResource"
      ],
      "Resource": "${ledger_factory_log_group_arn}",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/managed_by": "reviewed-direct-logs",
          "aws:RequestTag/service": "scanalyze-platform-authority",
          "aws:RequestTag/work_package": "GUG-365",
          "aws:RequestTag/environment": "non-production",
          "aws:RequestTag/production": "false",
          "aws:RequestTag/source_commit": "${source_commit}",
          "aws:RequestTag/gug363_pre_function_binding_sha256": "${gug363_pre_function_binding_sha256}"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "managed_by",
            "service",
            "work_package",
            "environment",
            "production",
            "source_commit",
            "gug363_pre_function_binding_sha256"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:PutRetentionPolicy",
        "logs:ListTagsForResource"
      ],
      "Resource": "${ledger_factory_log_group_arn}"
    },
    {
      "Effect": "Deny",
      "NotAction": [
        "sts:GetCallerIdentity",
        "iam:PassRole",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListEntitiesForPolicy",
        "iam:ListPolicyVersions",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "s3:GetObjectVersion",
        "kms:Decrypt",
        "lambda:CreateFunction",
        "lambda:GetCodeSigningConfig",
        "lambda:GetFunction",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:GetRuntimeManagementConfig",
        "lambda:ListAliases",
        "lambda:ListFunctionUrlConfigs",
        "lambda:ListTags",
        "lambda:ListVersionsByFunction",
        "lambda:PutFunctionConcurrency",
        "lambda:PutRuntimeManagementConfig",
        "lambda:TagResource",
        "logs:CreateLogGroup",
        "logs:DescribeLogGroups",
        "logs:ListTagsForResource",
        "logs:PutRetentionPolicy",
        "logs:TagResource"
      ],
      "Resource": "*"
    }
  ]
}
