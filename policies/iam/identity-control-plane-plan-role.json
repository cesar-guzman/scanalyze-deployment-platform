{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListIdentityState",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-state",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/operation": "plan",
          "aws:PrincipalTag/layer": "identity-control-plane"
        },
        "StringLike": {
          "s3:prefix": [
            "${deployment_id}/${region}/identity-control-plane/terraform.tfstate",
            "${deployment_id}/${region}/identity-control-plane/terraform.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Sid": "ReadIdentityLayerState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-state/${deployment_id}/${region}/identity-control-plane/terraform.tfstate"
    },
    {
      "Sid": "ManageIdentityLayerLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-state/${deployment_id}/${region}/identity-control-plane/terraform.tfstate.tflock"
    },
    {
      "Sid": "WriteIdentityPlanExecutionZone",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-plan/plan-execution/${deployment_id}/${aws:PrincipalTag/change_id}/identity-control-plane/plan.tfplan",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/operation": "plan",
          "aws:PrincipalTag/layer": "identity-control-plane"
        }
      }
    },
    {
      "Sid": "UseStateKeyForIdentityPlan",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": [
        "arn:${aws_partition}:kms:${region}:${account_id}:key/${state_kms_key_id}"
      ]
    },
    {
      "Sid": "EncryptExactIdentitySavedPlan",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:Encrypt", "kms:GenerateDataKey"],
      "Resource": "arn:${aws_partition}:kms:${region}:${account_id}:key/${evidence_kms_key_id}",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/operation": "plan",
          "aws:PrincipalTag/layer": "identity-control-plane",
          "kms:ViaService": "s3.${region}.${aws_url_suffix}",
          "kms:EncryptionContext:aws:s3:arn": "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-plan"
        }
      }
    },
    {
      "Sid": "ReadIdentityContractsAndArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:${aws_partition}:s3:::scanalyze-${account_id}-contracts/${deployment_id}/identity-control-plane/*",
        "arn:${aws_partition}:s3:::scanalyze-shared-releases/*",
        "arn:${aws_partition}:ssm:${region}:${account_id}:parameter/scanalyze/deployments/${deployment_id}/contracts/*"
      ]
    },
    {
      "Sid": "ReadDeploymentIdentityResources",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DescribeAlarms",
        "cognito-idp:DescribeUserPool",
        "cognito-idp:DescribeUserPoolDomain",
        "cognito-idp:GetGroup",
        "cognito-idp:ListGroups",
        "dynamodb:DescribeTable",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "lambda:GetAlias",
        "lambda:GetFunction",
        "lambda:GetPolicy",
        "logs:DescribeLogGroups",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ValidateIdentityDestinationAccount",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/operation": "plan",
          "aws:PrincipalTag/layer": "identity-control-plane"
        }
      }
    },
    {
      "Sid": "DecryptIdentityContracts",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": [
        "arn:${aws_partition}:kms:${region}:${account_id}:key/${state_kms_key_id}",
        "arn:${aws_partition}:kms:${region}:${account_id}:key/${contracts_kms_key_id}"
      ]
    }
  ]
}
