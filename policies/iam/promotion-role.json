{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPromotionInputs",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": [
        "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-evidence/evidence/${deployment_id}/*",
        "arn:${aws_partition}:s3:::scanalyze-${account_id}-contracts/${deployment_id}/*"
      ],
      "Condition": {"StringEquals": {"aws:PrincipalTag/operation": "promote", "aws:PrincipalTag/layer": "artifact-publication"}}
    },
    {
      "Sid": "PublishImages",
      "Effect": "Allow",
      "Action": ["ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:CompleteLayerUpload", "ecr:GetDownloadUrlForLayer", "ecr:InitiateLayerUpload", "ecr:PutImage", "ecr:UploadLayerPart"],
      "Resource": "arn:${aws_partition}:ecr:${region}:${account_id}:repository/scanalyze/*",
      "Condition": {"StringEquals": {"aws:PrincipalTag/operation": "promote", "aws:PrincipalTag/layer": "artifact-publication"}}
    },
    {
      "Sid": "GetEcrAuthorizationToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:PrincipalTag/operation": "promote", "aws:PrincipalTag/layer": "artifact-publication"}}
    },
    {
      "Sid": "PublishFrontendRelease",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket", "s3:PutObject"],
      "Resource": [
        "arn:${aws_partition}:s3:::scanalyze-${account_id}-frontend",
        "arn:${aws_partition}:s3:::scanalyze-${account_id}-frontend/releases/${deployment_id}/*"
      ],
      "Condition": {"StringEquals": {"aws:PrincipalTag/operation": "promote", "aws:PrincipalTag/layer": "artifact-publication"}}
    },
    {
      "Sid": "InvalidateExactDistribution",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:${aws_partition}:cloudfront::${account_id}:distribution/*",
      "Condition": {"StringEquals": {"aws:PrincipalTag/operation": "promote", "aws:PrincipalTag/layer": "artifact-publication", "aws:ResourceTag/deployment_id": "${deployment_id}"}}
    },
    {
      "Sid": "UsePromotionInputKeys",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:DescribeKey"],
      "Resource": [
        "arn:${aws_partition}:kms:${region}:${account_id}:key/${evidence_kms_key_id}",
        "arn:${aws_partition}:kms:${region}:${account_id}:key/${contracts_kms_key_id}"
      ],
      "Condition": {"StringEquals": {"aws:PrincipalTag/operation": "promote", "aws:PrincipalTag/layer": "artifact-publication"}}
    },
    {
      "Sid": "DenyPromotionInfrastructureAndState",
      "Effect": "Deny",
      "Action": ["cloudformation:*", "dynamodb:*", "ec2:*", "ecs:*", "iam:*", "organizations:*", "sqs:*", "ssm:PutParameter", "sts:AssumeRole"],
      "Resource": "*"
    }
  ]
}
