{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeploymentResourcesForDiagnostic",
      "Effect": "Allow",
      "Action": [
        "acm:Describe*",
        "apigateway:GET",
        "cloudfront:Get*",
        "cloudwatch:Describe*",
        "cloudwatch:GetMetric*",
        "cognito-idp:DescribeUserPool",
        "cognito-idp:DescribeUserPoolDomain",
        "dynamodb:Describe*",
        "ec2:Describe*",
        "ecs:Describe*",
        "ecs:List*",
        "elasticloadbalancing:Describe*",
        "iam:Get*",
        "iam:List*",
        "kms:Describe*",
        "kms:List*",
        "lambda:Get*",
        "logs:Describe*",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "route53:Get*",
        "route53:List*",
        "s3:GetBucket*",
        "s3:ListAllMyBuckets",
        "sqs:GetQueue*",
        "sqs:ListQueues",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "wafv2:Get*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/operation": "diagnostic"
        }
      }
    },
    {
      "Sid": "ReadDiagnosticBaselineObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-state/${deployment_id}/*/terraform.tfstate",
        "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-evidence/evidence/${deployment_id}/*",
        "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-evidence/recovery/${deployment_id}/*",
        "arn:${aws_partition}:s3:::scanalyze-${account_id}-contracts/${deployment_id}/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/operation": "diagnostic"
        }
      }
    },
    {
      "Sid": "DecryptDiagnosticInputs",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": [
        "arn:${aws_partition}:kms:${region}:${account_id}:key/${state_kms_key_id}",
        "arn:${aws_partition}:kms:${region}:${account_id}:key/${evidence_kms_key_id}",
        "arn:${aws_partition}:kms:${region}:${account_id}:key/${contracts_kms_key_id}"
      ],
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/operation": "diagnostic"
        }
      }
    },
    {
      "Sid": "DenyDiagnosticWritesAndRoleChaining",
      "Effect": "Deny",
      "Action": [
        "dynamodb:Delete*",
        "dynamodb:Put*",
        "dynamodb:Update*",
        "ec2:Create*",
        "ec2:Delete*",
        "ec2:Modify*",
        "ecs:Create*",
        "ecs:Delete*",
        "ecs:RunTask",
        "ecs:Update*",
        "iam:Attach*",
        "iam:Create*",
        "iam:Delete*",
        "iam:Detach*",
        "iam:Put*",
        "iam:Update*",
        "s3:Delete*",
        "s3:Put*",
        "sqs:Delete*",
        "sqs:PurgeQueue",
        "sqs:SendMessage",
        "ssm:DeleteParameter",
        "ssm:PutParameter",
        "sts:AssumeRole"
      ],
      "Resource": "*"
    }
  ]
}
