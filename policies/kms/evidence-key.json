{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPlanEncrypt",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:${aws_partition}:iam::${account_id}:role/ScanalyzeCustomer-Plan",
          "arn:${aws_partition}:iam::${account_id}:role/ScanalyzeCustomer-Identity-Plan"
        ]
      },
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.${region}.${aws_url_suffix}",
          "kms:EncryptionContext:aws:s3:arn": "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-plan"
        }
      }
    },
    {
      "Sid": "AllowPlanReconcile",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:${aws_partition}:iam::${account_id}:role/ScanalyzeCustomer-Plan",
          "arn:${aws_partition}:iam::${account_id}:role/ScanalyzeCustomer-Identity-Plan"
        ]
      },
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.${region}.${aws_url_suffix}",
          "kms:EncryptionContext:aws:s3:arn": "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-plan"
        }
      }
    },
    {
      "Sid": "AllowApplyDecrypt",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:${aws_partition}:iam::${account_id}:role/ScanalyzeCustomer-Apply",
          "arn:${aws_partition}:iam::${account_id}:role/ScanalyzeCustomer-Identity-Apply"
        ]
      },
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.${region}.${aws_url_suffix}",
          "kms:EncryptionContext:aws:s3:arn": "arn:${aws_partition}:s3:::scanalyze-${account_id}-tf-plan"
        }
      }
    },
    {
      "Sid": "AllowDiagnosticValidationDecrypt",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": [
          "arn:${aws_partition}:iam::${account_id}:role/ScanalyzeCustomer-Validation",
          "arn:${aws_partition}:iam::${account_id}:role/ScanalyzeCustomer-Diagnostic"
        ]
      }
    },
    {
      "Sid": "AllowKeyAdmin",
      "Effect": "Allow",
      "Action": [
        "kms:Create*",
        "kms:Describe*",
        "kms:Enable*",
        "kms:List*",
        "kms:Put*",
        "kms:Update*",
        "kms:Revoke*",
        "kms:Disable*",
        "kms:Get*",
        "kms:TagResource",
        "kms:UntagResource"
      ],
      "Resource": "*",
      "Principal": {
        "AWS": "arn:${aws_partition}:iam::${account_id}:root"
      }
    },
    {
      "Sid": "DenyKeyDeletionExceptBreakGlass",
      "Effect": "Deny",
      "Action": "kms:ScheduleKeyDeletion",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": "arn:${aws_partition}:iam::${account_id}:role/ScanalyzeCustomer-StateRecovery"
        }
      }
    }
  ]
}
