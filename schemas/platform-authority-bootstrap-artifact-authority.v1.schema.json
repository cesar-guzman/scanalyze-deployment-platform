{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/platform-authority-bootstrap-artifact-authority.v1.schema.json",
  "title": "Platform Authority Bootstrap Artifact Authority Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "domain_separator",
    "trust_contract_version", "trust_root_id", "trust_root_generation",
    "trust_algorithm", "authority_record_id", "state", "version",
    "attempt_count", "plan", "approval", "identity_binding_digest",
    "plan_identity_proof", "approval_identity_proof", "apply_identity_proof",
    "created_at", "updated_at", "claimed_at", "previous_ledger_digest",
    "ledger_digest"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "record_type": { "type": "string", "const": "platform_authority_bootstrap_artifact_authority" },
    "domain_separator": { "type": "string", "const": "scanalyze.platform-authority.bootstrap.artifact-authority.v1" },
    "trust_contract_version": { "type": "string", "const": "1" },
    "trust_root_id": { "$ref": "#/$defs/trust_root_id" },
    "trust_root_generation": { "type": "integer", "const": 1 },
    "trust_algorithm": { "type": "string", "const": "AWS_DYNAMODB_STRONGLY_CONSISTENT_CAS_SHA256" },
    "authority_record_id": { "$ref": "#/$defs/authority_record_id" },
    "state": { "type": "string", "enum": ["PLAN_ANCHORED", "APPROVED", "CLAIMED"] },
    "version": { "type": "integer", "enum": [1, 2, 3] },
    "attempt_count": { "type": "integer", "enum": [0, 1] },
    "plan": { "$ref": "https://scanalyze.dev/schemas/platform-authority-bootstrap-plan.v2.schema.json" },
    "approval": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://scanalyze.dev/schemas/platform-authority-bootstrap-approval.v2.schema.json" }
      ]
    },
    "identity_binding_digest": { "$ref": "#/$defs/digest" },
    "plan_identity_proof": { "$ref": "https://scanalyze.dev/schemas/platform-authority-bootstrap-identity-proof-receipt.v1.schema.json" },
    "approval_identity_proof": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://scanalyze.dev/schemas/platform-authority-bootstrap-identity-proof-receipt.v1.schema.json" }
      ]
    },
    "apply_identity_proof": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://scanalyze.dev/schemas/platform-authority-bootstrap-identity-proof-receipt.v1.schema.json" }
      ]
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "claimed_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
    "previous_ledger_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "ledger_digest": { "$ref": "#/$defs/digest" }
  },
  "oneOf": [
    {
      "title": "PLAN_ANCHORED is an unapproved and unclaimed first version",
      "properties": {
        "state": { "type": "string", "const": "PLAN_ANCHORED" },
        "version": { "type": "integer", "const": 1 },
        "attempt_count": { "type": "integer", "const": 0 },
        "approval": { "type": "null" },
        "plan_identity_proof": { "$ref": "#/$defs/plan_proof" },
        "approval_identity_proof": { "type": "null" },
        "apply_identity_proof": { "type": "null" },
        "claimed_at": { "type": "null" },
        "previous_ledger_digest": { "type": "null" }
      }
    },
    {
      "title": "APPROVED has one approval proof but no execution claim",
      "properties": {
        "state": { "type": "string", "const": "APPROVED" },
        "version": { "type": "integer", "const": 2 },
        "attempt_count": { "type": "integer", "const": 0 },
        "approval": { "$ref": "https://scanalyze.dev/schemas/platform-authority-bootstrap-approval.v2.schema.json" },
        "plan_identity_proof": { "$ref": "#/$defs/plan_proof" },
        "approval_identity_proof": { "$ref": "#/$defs/approval_proof" },
        "apply_identity_proof": { "type": "null" },
        "claimed_at": { "type": "null" },
        "previous_ledger_digest": { "$ref": "#/$defs/digest" }
      }
    },
    {
      "title": "CLAIMED is the terminal one-shot attempt with all proofs",
      "properties": {
        "state": { "type": "string", "const": "CLAIMED" },
        "version": { "type": "integer", "const": 3 },
        "attempt_count": { "type": "integer", "const": 1 },
        "approval": { "$ref": "https://scanalyze.dev/schemas/platform-authority-bootstrap-approval.v2.schema.json" },
        "plan_identity_proof": { "$ref": "#/$defs/plan_proof" },
        "approval_identity_proof": { "$ref": "#/$defs/approval_proof" },
        "apply_identity_proof": { "$ref": "#/$defs/apply_proof" },
        "claimed_at": { "$ref": "#/$defs/timestamp" },
        "previous_ledger_digest": { "$ref": "#/$defs/digest" }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "trust_root_id": {
      "type": "string",
      "pattern": "^arn:(?:aws|aws-us-gov|aws-cn):dynamodb:[a-z0-9-]+:[0-9]{12}:table/scanalyze-platform-authority-bootstrap-artifacts#generation/1$"
    },
    "authority_record_id": {
      "type": "string", "pattern": "^gug274#g1#sha256:[a-f0-9]{64}$"
    },
    "plan_proof": {
      "allOf": [
        { "$ref": "https://scanalyze.dev/schemas/platform-authority-bootstrap-identity-proof-receipt.v1.schema.json" },
        {
          "properties": {
            "operation": { "type": "string", "const": "plan" },
            "role_kind": { "type": "string", "const": "plan_author" }
          }
        }
      ]
    },
    "approval_proof": {
      "allOf": [
        { "$ref": "https://scanalyze.dev/schemas/platform-authority-bootstrap-identity-proof-receipt.v1.schema.json" },
        {
          "properties": {
            "operation": { "type": "string", "const": "approval" },
            "role_kind": { "type": "string", "const": "independent_approver" }
          }
        }
      ]
    },
    "apply_proof": {
      "allOf": [
        { "$ref": "https://scanalyze.dev/schemas/platform-authority-bootstrap-identity-proof-receipt.v1.schema.json" },
        {
          "properties": {
            "operation": { "type": "string", "const": "apply" },
            "role_kind": { "type": "string", "const": "apply_verifier" }
          }
        }
      ]
    }
  }
}
