{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/identity-runtime-artifact.v1.schema.json",
  "title": "Scanalyze Identity Runtime Artifact Projection v1",
  "description": "Verified projection of release/v2 identity Lambda artifacts into the shape required by identity-control-plane. Closed schema; no extra fields allowed.",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "customer_id",
    "deployment_id",
    "account_id",
    "region",
    "release_version",
    "manifest_digest",
    "contract_digest",
    "pre_token_artifact",
    "control_processor_artifact"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "identity-runtime-artifact.v1"
    },
    "contract_id": {
      "const": "release-manifest/v1"
    },
    "customer_id": {
      "$ref": "#/$defs/customer_id"
    },
    "deployment_id": {
      "$ref": "#/$defs/deployment_id"
    },
    "account_id": {
      "$ref": "#/$defs/account_id"
    },
    "region": {
      "$ref": "#/$defs/region"
    },
    "release_version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "manifest_digest": {
      "$ref": "#/$defs/sha256"
    },
    "contract_digest": {
      "$ref": "#/$defs/sha256"
    },
    "pre_token_artifact": {
      "$ref": "#/$defs/s3_locator"
    },
    "control_processor_artifact": {
      "$ref": "#/$defs/s3_locator"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "customer_id": {
      "type": "string",
      "pattern": "^cust_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "deployment_id": {
      "type": "string",
      "pattern": "^dep_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "account_id": {
      "type": "string",
      "pattern": "^[0-9]{12}$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+$"
    },
    "s3_locator": {
      "type": "object",
      "required": [
        "bucket",
        "key",
        "object_version",
        "sha256_b64"
      ],
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "object_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "not": {
            "const": "null"
          }
        },
        "sha256_b64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"
        }
      }
    }
  }
}
