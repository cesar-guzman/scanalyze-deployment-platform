{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/edge-route-policy.v1.schema.json",
  "title": "Explicit reviewed gateway prefilter subset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_digest", "source_commit", "source_tree_digest", "inventory_digest", "openapi_digest", "authorization_policy_digest", "authorization_policy_version", "authorization_source_digest", "rewrite_source_digest", "routes"],
  "properties": {
    "schema_version": {"const": "edge-route-policy.v1"},
    "record_digest": {"$ref": "#/$defs/digest"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_tree_digest": {"$ref": "#/$defs/digest"},
    "inventory_digest": {"$ref": "#/$defs/digest"},
    "openapi_digest": {"$ref": "#/$defs/digest"},
    "authorization_policy_digest": {"$ref": "#/$defs/digest"},
    "authorization_policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "authorization_source_digest": {"$ref": "#/$defs/digest"},
    "rewrite_source_digest": {"$ref": "#/$defs/digest"},
    "routes": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["method", "path", "operation_ids", "prefilter_scope"],
        "properties": {
          "method": {"enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS", "HEAD"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "operation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.]+$"}},
          "prefilter_scope": {"enum": ["scanalyze.api.v1/read", "scanalyze.api.v1/write", "scanalyze.api.v1/admin"]}
        }
      }
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
