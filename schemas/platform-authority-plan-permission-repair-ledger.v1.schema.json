{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/platform-authority-plan-permission-repair-ledger.v1.schema.json",
  "title": "Platform Authority Plan Permission Repair Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "repair_id", "intent_digest",
    "source_commit", "status", "stage", "effects_attempted",
    "effects_completed", "planned_state_digest", "state_digest", "planned_at",
    "provider_immutable", "claim_condition", "mutation_retry_attempted",
    "retry_permitted", "production_authorized", "ledger_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "scanalyze.platform_authority.plan_permission_repair_ledger.v1" },
    "repair_id": { "type": "string", "pattern": "^gug376-plan-permission-repair-[0-9a-f]{64}$" },
    "intent_digest": { "$ref": "#/$defs/digest" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "status": {
      "enum": [
        "PLAN_VERIFIED", "CLAIMED", "ATTEMPTING_1", "COMPLETED_1",
        "ATTEMPTING_2", "COMPLETED_2", "REPAIR_VERIFIED",
        "UNCERTAIN_RECONCILE_ONLY"
      ]
    },
    "stage": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "effects_attempted": { "type": "integer", "minimum": 0, "maximum": 2 },
    "effects_completed": { "type": "integer", "minimum": 0, "maximum": 2 },
    "planned_state_digest": { "$ref": "#/$defs/digest" },
    "state_digest": { "$ref": "#/$defs/digest" },
    "planned_at": { "$ref": "#/$defs/timestamp" },
    "claimed_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "provider_immutable": { "const": true },
    "claim_condition": { "const": "attribute_not_exists(repair_id)" },
    "mutation_retry_attempted": { "const": false },
    "retry_permitted": { "const": false },
    "production_authorized": { "const": false },
    "ledger_digest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PLAN_VERIFIED" } }, "required": ["status"] },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["claimed_at"] },
            { "required": ["updated_at"] }
          ]
        }
      },
      "else": { "required": ["claimed_at", "updated_at"] }
    },
    {
      "oneOf": [
        { "$ref": "#/$defs/plan" },
        { "$ref": "#/$defs/claimed" },
        { "$ref": "#/$defs/attempting_1" },
        { "$ref": "#/$defs/completed_1" },
        { "$ref": "#/$defs/attempting_2" },
        { "$ref": "#/$defs/completed_2" },
        { "$ref": "#/$defs/verified" },
        { "$ref": "#/$defs/uncertain" }
      ]
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "plan": { "$ref": "#/$defs/progress_0", "properties": { "status": { "const": "PLAN_VERIFIED" }, "stage": { "const": "PLAN_STATE_VERIFIED" } } },
    "claimed": { "$ref": "#/$defs/progress_0", "properties": { "status": { "const": "CLAIMED" }, "stage": { "const": "BEFORE_FIRST_EFFECT" } } },
    "attempting_1": { "$ref": "#/$defs/progress_0", "properties": { "status": { "const": "ATTEMPTING_1" }, "stage": { "const": "BEFORE_PUT_INLINE_POLICY" } } },
    "completed_1": { "$ref": "#/$defs/progress_1", "properties": { "status": { "const": "COMPLETED_1" }, "stage": { "const": "AFTER_PUT_INLINE_POLICY" } } },
    "attempting_2": { "$ref": "#/$defs/progress_1", "properties": { "status": { "const": "ATTEMPTING_2" }, "stage": { "const": "BEFORE_PROVISION_PERMISSION_SET" } } },
    "completed_2": { "$ref": "#/$defs/progress_2", "properties": { "status": { "const": "COMPLETED_2" }, "stage": { "const": "AFTER_PROVISION_PERMISSION_SET" } } },
    "verified": { "$ref": "#/$defs/progress_2", "properties": { "status": { "const": "REPAIR_VERIFIED" }, "stage": { "const": "FINAL_READBACK_VERIFIED" } } },
    "progress_0": { "properties": { "effects_attempted": { "const": 0 }, "effects_completed": { "const": 0 } } },
    "progress_1": { "properties": { "effects_attempted": { "const": 1 }, "effects_completed": { "const": 1 } } },
    "progress_2": { "properties": { "effects_attempted": { "const": 2 }, "effects_completed": { "const": 2 } } },
    "uncertain": {
      "properties": { "status": { "const": "UNCERTAIN_RECONCILE_ONLY" } },
      "oneOf": [
        { "properties": { "stage": { "const": "UNCERTAIN_PUT_INLINE_POLICY" }, "effects_attempted": { "const": 1 }, "effects_completed": { "const": 0 } } },
        { "properties": { "stage": { "const": "UNCERTAIN_PUT_INLINE_POLICY_LEDGER_COMMIT" }, "effects_attempted": { "const": 1 }, "effects_completed": { "const": 1 } } },
        { "properties": { "stage": { "const": "UNCERTAIN_PROVISION_PERMISSION_SET" }, "effects_attempted": { "const": 2 }, "effects_completed": { "const": 1 } } },
        { "properties": { "stage": { "const": "UNCERTAIN_PROVISION_PERMISSION_SET_LEDGER_COMMIT" }, "effects_attempted": { "const": 2 }, "effects_completed": { "const": 2 } } },
        { "properties": { "stage": { "const": "UNCERTAIN_FINAL_READBACK" }, "effects_attempted": { "const": 2 }, "effects_completed": { "const": 2 } } }
      ]
    }
  }
}
