{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/platform-authority-retirement-entrypoint-execution-ledger.v1.schema.json",
  "title": "GUG-363 Retirement Entrypoint Consumed Execution Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "schema_version", "issue_id", "live_issue", "environment",
    "production", "status", "plan_digest", "authorization_digest",
    "create_stack_request_digest", "operation_list_digest",
    "artifact_signing_contract_digest",
    "client_request_token_sha256", "caller_arn_sha256", "caller_user_id_sha256",
    "target_digest", "allowed_action", "attempt_limit", "attempts",
    "execution_gate_consumed", "mutation_retry_authorized", "broker_invocations",
    "retirement_effects_attempted", "claimed_at", "ledger_digest"
  ],
  "properties": {
    "record_type": { "const": "scanalyze.platform_authority.retirement_entrypoint_execution_ledger.v1" },
    "schema_version": { "const": 1 },
    "issue_id": { "const": "GUG-363" },
    "live_issue": { "const": "GUG-357" },
    "environment": { "const": "synthetic-non-production" },
    "production": { "const": false },
    "status": { "const": "MUTATION_WINDOW_CONSUMED" },
    "plan_digest": {
      "description": "Binds the consumed plan, including its ordered 35-row CloudFormation parameter projection and visible private projection digest.",
      "$ref": "#/$defs/digest"
    },
    "authorization_digest": { "$ref": "#/$defs/digest" },
    "create_stack_request_digest": { "$ref": "#/$defs/digest" },
    "operation_list_digest": { "$ref": "#/$defs/digest" },
    "artifact_signing_contract_digest": { "$ref": "#/$defs/digest" },
    "client_request_token_sha256": { "$ref": "#/$defs/digest" },
    "caller_arn_sha256": { "$ref": "#/$defs/digest" },
    "caller_user_id_sha256": { "$ref": "#/$defs/digest" },
    "target_digest": { "$ref": "#/$defs/digest" },
    "allowed_action": { "const": "cloudformation:CreateStack" },
    "attempt_limit": { "const": 1 },
    "attempts": { "const": 1 },
    "execution_gate_consumed": { "const": true },
    "mutation_retry_authorized": { "const": false },
    "broker_invocations": { "const": 0 },
    "retirement_effects_attempted": { "const": 0 },
    "claimed_at": { "$ref": "#/$defs/timestamp" },
    "ledger_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
