{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/platform-authority-gug365-phase-execution-ledger.v1.schema.json",
  "title": "GUG-365 durable phase execution ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "schema_version", "ledger_id", "ledger_version",
    "initial_ledger_digest", "previous_ledger_digest", "plan_digest",
    "bundle_digest", "account_id", "region", "profile_class",
    "caller_arn_digest", "executor_authority_evidence_digest",
    "authority_session_identifier_digest", "authority_session_issued_at",
    "authority_session_expires_at", "authority_evidence_collected_at",
    "authority_evaluation_at", "phase",
    "ordered_operations_digest", "operation_count", "ordered_request_digests",
    "not_before", "expires_at", "host_digest", "predecessor_phase",
    "predecessor_terminal_receipt_digest", "predecessor_ledger_digest",
    "before_state_digest", "required_predecessor_checkpoint_digest",
    "status", "attempt_count",
    "claim", "operation_outcomes", "in_flight_operation", "reconciliation",
    "receipt_chain", "ledger_digest"
  ],
  "properties": {
    "record_type": {"const": "scanalyze.platform_authority.gug365_phase_execution_ledger.v1"},
    "schema_version": {"const": 1},
    "ledger_id": {"$ref": "#/$defs/digest"},
    "ledger_version": {"type": "integer", "minimum": 1},
    "initial_ledger_digest": {"$ref": "#/$defs/digest"},
    "previous_ledger_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "bundle_digest": {"$ref": "#/$defs/digest"},
    "account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
    "region": {"type": "string", "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]$"},
    "profile_class": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$"},
    "caller_arn_digest": {"$ref": "#/$defs/digest"},
    "executor_authority_evidence_digest": {"$ref": "#/$defs/digest"},
    "authority_session_identifier_digest": {"$ref": "#/$defs/digest"},
    "authority_session_issued_at": {"$ref": "#/$defs/timestamp"},
    "authority_session_expires_at": {"$ref": "#/$defs/timestamp"},
    "authority_evidence_collected_at": {"$ref": "#/$defs/timestamp"},
    "authority_evaluation_at": {"$ref": "#/$defs/timestamp"},
    "phase": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$"},
    "ordered_operations_digest": {"$ref": "#/$defs/digest"},
    "operation_count": {"type": "integer", "minimum": 1},
    "ordered_request_digests": {
      "description": "Digests of the provider operation requests in immutable execution order. These operation-level request digests are distinct from the GUG-390 live_request_digest.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/digest"}
    },
    "not_before": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "host_digest": {"$ref": "#/$defs/digest"},
    "predecessor_phase": {"oneOf": [{"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$"}, {"type": "null"}]},
    "predecessor_terminal_receipt_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "predecessor_ledger_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "before_state_digest": {"$ref": "#/$defs/digest"},
    "required_predecessor_checkpoint_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["PREPARED", "CLAIMED", "IN_FLIGHT", "AMBIGUOUS", "CONSUMED", "RECONCILED"]},
    "attempt_count": {"enum": [0, 1]},
    "claim": {"oneOf": [{"$ref": "#/$defs/claim"}, {"type": "null"}]},
    "operation_outcomes": {"type": "array", "items": {"$ref": "#/$defs/operation_outcome"}},
    "in_flight_operation": {"oneOf": [{"$ref": "#/$defs/in_flight_operation"}, {"type": "null"}]},
    "reconciliation": {"oneOf": [{"$ref": "#/$defs/reconciliation"}, {"type": "null"}]},
    "receipt_chain": {"type": "array", "items": {"$ref": "#/$defs/receipt"}},
    "ledger_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "claim": {
      "oneOf": [
        {"$ref": "#/$defs/legacy_claim"},
        {"$ref": "#/$defs/gug390_claim"}
      ]
    },
    "legacy_claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_nonce_digest", "claimed_at", "first_operation_sequence", "next_operation_sequence"],
      "properties": {
        "claim_nonce_digest": {"$ref": "#/$defs/digest"},
        "claimed_at": {"$ref": "#/$defs/timestamp"},
        "first_operation_sequence": {"const": 1},
        "next_operation_sequence": {"type": "integer", "minimum": 1}
      }
    },
    "gug390_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_nonce_digest", "claimed_at", "first_operation_sequence",
        "next_operation_sequence", "execution_context"
      ],
      "properties": {
        "claim_nonce_digest": {"$ref": "#/$defs/digest"},
        "claimed_at": {"$ref": "#/$defs/timestamp"},
        "first_operation_sequence": {"const": 1},
        "next_operation_sequence": {"type": "integer", "minimum": 1},
        "execution_context": {"$ref": "#/$defs/execution_context"}
      }
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue", "owner_checkpoint_digest", "live_request_digest",
        "activator_checkpoint_digest", "context_digest"
      ],
      "properties": {
        "issue": {"const": "GUG-390"},
        "owner_checkpoint_digest": {"$ref": "#/$defs/digest"},
        "live_request_digest": {"$ref": "#/$defs/digest"},
        "activator_checkpoint_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "context_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "in_flight_operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_sequence", "request_digest", "attempt", "started_at", "retry_permitted"],
      "properties": {
        "operation_sequence": {"type": "integer", "minimum": 1},
        "request_digest": {"$ref": "#/$defs/digest"},
        "attempt": {"const": 1},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "retry_permitted": {"const": false}
      }
    },
    "operation_outcome": {
      "oneOf": [
        {"$ref": "#/$defs/legacy_operation_outcome"},
        {"$ref": "#/$defs/gug390_operation_outcome"}
      ]
    },
    "legacy_operation_outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_sequence", "request_digest", "result", "provider_result_digest", "recorded_at", "write_attempt_count", "blind_retry_permitted", "next_required_action"],
      "properties": {
        "operation_sequence": {"type": "integer", "minimum": 1},
        "request_digest": {"$ref": "#/$defs/digest"},
        "result": {"enum": ["SUCCEEDED", "FAILED", "AMBIGUOUS"]},
        "provider_result_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "write_attempt_count": {"const": 1},
        "blind_retry_permitted": {"const": false},
        "next_required_action": {"enum": ["NO_RETRY", "ATTEMPT_NEXT_ORDERED_OPERATION_ONCE", "STOP_PHASE_NO_RETRY", "RECONCILE_READ_ONLY"]}
      }
    },
    "gug390_operation_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_sequence", "request_digest", "result",
        "provider_result_digest", "recorded_at", "write_attempt_count",
        "blind_retry_permitted", "next_required_action",
        "durable_provider_evidence"
      ],
      "properties": {
        "operation_sequence": {"type": "integer", "minimum": 1},
        "request_digest": {
          "description": "Digest of this exact provider operation request; never the GUG-390 live request digest.",
          "$ref": "#/$defs/digest"
        },
        "result": {"enum": ["SUCCEEDED", "FAILED", "AMBIGUOUS"]},
        "provider_result_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "write_attempt_count": {"const": 1},
        "blind_retry_permitted": {"const": false},
        "next_required_action": {"enum": ["NO_RETRY", "ATTEMPT_NEXT_ORDERED_OPERATION_ONCE", "STOP_PHASE_NO_RETRY", "RECONCILE_READ_ONLY"]},
        "durable_provider_evidence": {"$ref": "#/$defs/durable_provider_evidence"}
      }
    },
    "durable_provider_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type", "schema_version", "issue", "phase",
        "operation_sequence", "operation_digest", "provider_request_digest",
        "outcome", "provider_result_digest", "provider_mode",
        "identity_receipt", "identity_receipt_digest", "caller_arn_digest",
        "session_identifier_digest", "transcript_before",
        "transcript_before_receipt_digest", "transcript",
        "transcript_receipt_digest", "owner_checkpoint_digest",
        "live_request_digest", "execution_context_digest",
        "activator_checkpoint_digest", "causal_receipt_evidence",
        "causal_receipt_evidence_digest", "private_provider_evidence_file",
        "private_provider_evidence_digest", "evidence_digest"
      ],
      "properties": {
        "record_type": {"const": "scanalyze.platform_authority.gug390_durable_provider_evidence.v1"},
        "schema_version": {"const": 1},
        "issue": {"const": "GUG-390"},
        "phase": {
          "enum": [
            "POLICY_FACTORY",
            "FOUNDATION_FACTORY",
            "FUNCTION_FACTORY",
            "LEDGER_FACTORY_FUNCTION_FACTORY",
            "LEDGER_FACTORY_ACTIVATOR",
            "LEDGER_FACTORY_INVOKER",
            "LEDGER_FACTORY_REVOKER",
            "ACTIVATOR"
          ]
        },
        "operation_sequence": {"type": "integer", "minimum": 1},
        "operation_digest": {"$ref": "#/$defs/digest"},
        "provider_request_digest": {"$ref": "#/$defs/digest"},
        "outcome": {"enum": ["SUCCEEDED", "FAILED", "AMBIGUOUS"]},
        "provider_result_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "provider_mode": {"enum": ["LIVE", "SYNTHETIC"]},
        "identity_receipt": {"type": "object", "minProperties": 1},
        "identity_receipt_digest": {"$ref": "#/$defs/digest"},
        "caller_arn_digest": {"$ref": "#/$defs/digest"},
        "session_identifier_digest": {"$ref": "#/$defs/digest"},
        "transcript_before": {"type": "object", "minProperties": 1},
        "transcript_before_receipt_digest": {"$ref": "#/$defs/digest"},
        "transcript": {"type": "object", "minProperties": 1},
        "transcript_receipt_digest": {"$ref": "#/$defs/digest"},
        "owner_checkpoint_digest": {"$ref": "#/$defs/digest"},
        "live_request_digest": {"$ref": "#/$defs/digest"},
        "execution_context_digest": {"$ref": "#/$defs/digest"},
        "activator_checkpoint_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "causal_receipt_evidence": {
          "oneOf": [
            {"type": "object", "minProperties": 1},
            {"type": "null"}
          ]
        },
        "causal_receipt_evidence_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "private_provider_evidence_file": {
          "type": "string",
          "pattern": "^gug390-provider-[0-9a-f]{64}-[0-9]{3}\\.json$"
        },
        "private_provider_evidence_digest": {"$ref": "#/$defs/digest"},
        "evidence_digest": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {"const": "ACTIVATOR"}
            }
          },
          "then": {
            "properties": {
              "activator_checkpoint_digest": {"$ref": "#/$defs/digest"}
            }
          },
          "else": {
            "properties": {
              "activator_checkpoint_digest": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "causal_receipt_evidence": {"type": "null"}
            }
          },
          "then": {
            "properties": {
              "causal_receipt_evidence_digest": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "causal_receipt_evidence_digest": {"$ref": "#/$defs/digest"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "causal_receipt_evidence": {"type": "object"}
            }
          },
          "then": {
            "properties": {
              "phase": {"const": "LEDGER_FACTORY_INVOKER"}
            }
          }
        }
      ]
    },
    "reconciliation": {
      "oneOf": [
        {"$ref": "#/$defs/legacy_reconciliation"},
        {"$ref": "#/$defs/legacy_bound_reconciliation"},
        {"$ref": "#/$defs/bound_reconciliation"}
      ]
    },
    "legacy_reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "observed_state_digest", "recorded_at", "read_only", "provider_writes_performed", "retry_of_ambiguous_write_permitted"],
      "properties": {
        "classification": {"enum": ["EFFECT_PROVEN", "NO_EFFECT_PROVEN", "INCONCLUSIVE"]},
        "observed_state_digest": {"$ref": "#/$defs/digest"},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "read_only": {"const": true},
        "provider_writes_performed": {"const": 0},
        "retry_of_ambiguous_write_permitted": {"const": false}
      }
    },
    "legacy_bound_reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "classification", "observed_state_digest", "recorded_at", "read_only",
        "provider_writes_performed", "retry_of_ambiguous_write_permitted",
        "binding_mode", "ambiguous_ledger_digest",
        "ambiguous_operation_sequence", "ambiguous_request_digest",
        "ambiguous_operation_digest", "readback_contract_digest",
        "caller_arn_digest", "session_identifier_digest",
        "identity_receipt_digest", "provider_transcript_digest",
        "expectation_binding_digest", "expected_effect_state_digest",
        "expected_no_effect_state_digest"
      ],
      "properties": {
        "classification": {"enum": ["EFFECT_PROVEN", "NO_EFFECT_PROVEN", "INCONCLUSIVE"]},
        "observed_state_digest": {"$ref": "#/$defs/digest"},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "read_only": {"const": true},
        "provider_writes_performed": {"const": 0},
        "retry_of_ambiguous_write_permitted": {"const": false},
        "binding_mode": {"const": "CAUSAL_EXPECTATIONS_BOUND"},
        "ambiguous_ledger_digest": {"$ref": "#/$defs/digest"},
        "ambiguous_operation_sequence": {"type": "integer", "minimum": 1},
        "ambiguous_request_digest": {"$ref": "#/$defs/digest"},
        "ambiguous_operation_digest": {"$ref": "#/$defs/digest"},
        "readback_contract_digest": {"$ref": "#/$defs/digest"},
        "caller_arn_digest": {"$ref": "#/$defs/digest"},
        "session_identifier_digest": {"$ref": "#/$defs/digest"},
        "identity_receipt_digest": {"$ref": "#/$defs/digest"},
        "provider_transcript_digest": {"$ref": "#/$defs/digest"},
        "expectation_binding_digest": {"$ref": "#/$defs/digest"},
        "expected_effect_state_digest": {"$ref": "#/$defs/digest"},
        "expected_no_effect_state_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "bound_reconciliation": {
      "type": "object", "additionalProperties": false,
      "dependentRequired": {
        "private_reconciliation_evidence_file": ["private_reconciliation_evidence_digest"],
        "private_reconciliation_evidence_digest": ["private_reconciliation_evidence_file"]
      },
      "required": [
        "classification", "observed_state_digest", "recorded_at", "read_only",
        "provider_writes_performed", "retry_of_ambiguous_write_permitted",
        "binding_mode", "ambiguous_ledger_digest",
        "ambiguous_operation_sequence", "ambiguous_request_digest",
        "ambiguous_operation_digest", "readback_contract_digest",
        "caller_arn_digest", "session_identifier_digest",
        "identity_receipt_digest", "provider_transcript_digest",
        "provider_transcript_summary_digest", "provider_call_count",
        "owner_checkpoint_digest", "live_request_digest",
        "execution_context_digest", "expectation_binding_digest",
        "expected_effect_state_digest", "expected_no_effect_state_digest"
      ],
      "properties": {
        "classification": {"enum": ["EFFECT_PROVEN", "NO_EFFECT_PROVEN", "INCONCLUSIVE"]},
        "observed_state_digest": {"$ref": "#/$defs/digest"},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "read_only": {"const": true},
        "provider_writes_performed": {"const": 0},
        "retry_of_ambiguous_write_permitted": {"const": false},
        "binding_mode": {"const": "CAUSAL_EXPECTATIONS_BOUND"},
        "ambiguous_ledger_digest": {"$ref": "#/$defs/digest"},
        "ambiguous_operation_sequence": {"type": "integer", "minimum": 1},
        "ambiguous_request_digest": {"$ref": "#/$defs/digest"},
        "ambiguous_operation_digest": {"$ref": "#/$defs/digest"},
        "readback_contract_digest": {"$ref": "#/$defs/digest"},
        "caller_arn_digest": {"$ref": "#/$defs/digest"},
        "session_identifier_digest": {"$ref": "#/$defs/digest"},
        "identity_receipt_digest": {"$ref": "#/$defs/digest"},
        "provider_transcript_digest": {"$ref": "#/$defs/digest"},
        "provider_transcript_summary_digest": {"$ref": "#/$defs/digest"},
        "provider_call_count": {"type": "integer", "minimum": 3},
        "owner_checkpoint_digest": {"$ref": "#/$defs/digest"},
        "live_request_digest": {"$ref": "#/$defs/digest"},
        "execution_context_digest": {"$ref": "#/$defs/digest"},
        "expectation_binding_digest": {"$ref": "#/$defs/digest"},
        "expected_effect_state_digest": {"$ref": "#/$defs/digest"},
        "expected_no_effect_state_digest": {"$ref": "#/$defs/digest"},
        "private_reconciliation_evidence_file": {
          "type": "string",
          "pattern": "^gug390-reconcile-[0-9a-f]{64}\\.json$"
        },
        "private_reconciliation_evidence_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "event", "at", "source_ledger_version", "source_ledger_digest", "previous_receipt_digest", "facts", "receipt_digest"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "event": {"enum": ["CLAIMED", "OPERATION_IN_FLIGHT", "OPERATION_SUCCEEDED", "OPERATION_FAILED", "OPERATION_AMBIGUOUS", "RECONCILED"]},
        "at": {"$ref": "#/$defs/timestamp"},
        "source_ledger_version": {"type": "integer", "minimum": 1},
        "source_ledger_digest": {"$ref": "#/$defs/digest"},
        "previous_receipt_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "facts": {
          "type": "object",
          "properties": {
            "request_digest": {"$ref": "#/$defs/digest"},
            "execution_context_digest": {"$ref": "#/$defs/digest"},
            "durable_provider_evidence_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "receipt_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
