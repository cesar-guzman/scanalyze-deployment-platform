{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.cloud/schemas/platform-authority-change-set-retirement-ledger.v4.schema.json",
  "title": "GUG-215 workforce retirement ledger v4",
