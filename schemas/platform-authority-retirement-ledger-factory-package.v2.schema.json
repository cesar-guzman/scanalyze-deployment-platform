{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/platform-authority-retirement-ledger-factory-package.v2.schema.json",
  "title": "GUG-215 unsigned workforce ledger-factory package v2 (not deployment authority)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "work_package",
    "production",
    "source_commit",
    "archive_name",
    "archive_format",
    "archive_sha256",
    "lambda_code_sha256",
    "archive_size_bytes",
    "handler",
    "runtime",
    "architecture",
    "runtime_dependency_mode",
    "runtime_version_arn_sha256",
    "environment",
    "entries",
    "deployment_authorized",
    "production_status",
    "manifest_digest",
    "authorization_mode",
    "artifact_status",
    "signature_status",
    "source_ci_status",
    "function_version_arn",
    "factory_contract_sha256",
    "provenance",
    "source_snapshot_status"
  ],
  "properties": {
    "artifact_type": {
      "const": "scanalyze.platform_authority.retirement_ledger_factory_package.v2"
    },
    "schema_version": {
      "const": 2
    },
    "work_package": {
      "const": "GUG-215"
    },
    "production": {
      "const": true
    },
    "source_commit": {
      "$ref": "#/$defs/commit"
    },
    "archive_name": {
      "const": "scanalyze-gug215-workforce-ledger-factory.zip"
    },
    "archive_format": {
      "const": "ZIP_STORED_FIXED_METADATA"
    },
    "archive_sha256": {
      "$ref": "#/$defs/hex_digest"
    },
    "lambda_code_sha256": {
      "$ref": "#/$defs/lambda_code_sha256"
    },
    "archive_size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 524288
    },
    "handler": {
      "const": "tooling.platform_authority_retirement_ledger_factory.handler_workforce"
    },
    "runtime": {
      "const": "python3.12"
    },
    "architecture": {
      "const": "x86_64"
    },
    "runtime_dependency_mode": {
      "const": "AWS_MANAGED_RUNTIME_PINNED"
    },
    "runtime_version_arn_sha256": {
      "$ref": "#/$defs/digest"
    },
    "environment": {
      "const": {}
    },
    "entries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "enum": [
              "tooling/__init__.py",
              "tooling/platform_authority_retirement_ledger_factory.py"
            ]
          },
          "sha256": {
            "$ref": "#/$defs/hex_digest"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 262144
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "path": {
                "const": "tooling/__init__.py"
              }
            },
            "required": [
              "path"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "path": {
                "const": "tooling/platform_authority_retirement_ledger_factory.py"
              }
            },
            "required": [
              "path"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "deployment_authorized": {
      "const": false
    },
    "production_status": {
      "const": "NO-GO"
    },
    "manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "authorization_mode": {
      "const": "WORKFORCE_SINGLE_OWNER_RETIREMENT_V1"
    },
    "artifact_status": {
      "const": "UNSIGNED_SOURCE_NOT_DEPLOYABLE"
    },
    "signature_status": {
      "const": "PENDING_SIGNING_AND_IMMUTABLE_VERSION_READBACK"
    },
    "source_ci_status": {
      "const": "PENDING_CONNECTED_REVALIDATION"
    },
    "function_version_arn": {
      "const": null
    },
    "factory_contract_sha256": {
      "$ref": "#/$defs/digest"
    },
    "provenance": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "const": "tooling/platform_authority_retirement_ledger_factory_package.py"
            },
            "sha256": {
              "$ref": "#/$defs/hex_digest"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "const": "schemas/platform-authority-retirement-ledger-factory-package.v2.schema.json"
            },
            "sha256": {
              "$ref": "#/$defs/hex_digest"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "const": "schemas/platform-authority-retirement-ledger-factory-receipt.v2.schema.json"
            },
            "sha256": {
              "$ref": "#/$defs/hex_digest"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "size_bytes"],
          "properties": {
            "path": {
              "const": "scripts/deployment/platform-authority-retirement-entrypoint-service-role.py"
            },
            "sha256": {"$ref": "#/$defs/hex_digest"},
            "size_bytes": {"type": "integer", "minimum": 1, "maximum": 262144}
          }
        }
      ],
      "items": false
    },
    "source_snapshot_status": {
      "const": "CAPTURED_BYTES_NOT_AUTHENTICATED"
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hex_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lambda_code_sha256": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    }
  }
}
