  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hex_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lambda_code_sha256": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    }
  },
  "description": "Pre-sign source only. This manifest does not authenticate source review, CI, signer output, runtime configuration, current exclusive assignment or execution authority. A future post-sign consumer must verify signature and exact versioned signed bytes before binding WorkforceRetirementConfig."
