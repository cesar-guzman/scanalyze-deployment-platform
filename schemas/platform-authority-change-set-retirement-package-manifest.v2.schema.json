        {
          "contains": {
            "properties": {
              "path": {
                "const": "tooling/platform_authority_change_set_retirement_broker.py"
              }
            },
            "required": [
              "path"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "path": {
                "const": "tooling/platform_authority_identity_context_compatibility.py"
              }
