        {
          "contains": {
            "properties": {
              "path": {
                "const": "tooling/platform_authority_identity_context_pep_runtime.py"
              }
            },
            "required": [
              "path"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "path": {
                "const": "tooling/platform_authority_single_operator_retirement_exception.py"
              }
            },
            "required": [
              "path"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "path": {
                "const": "tooling/platform_authority_workforce_stage_binding.py"
