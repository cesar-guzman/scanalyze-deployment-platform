      "properties": {"arn": {"type": "string"}, "attached_policy_arns": {"$ref": "#/$defs/string_array"}, "boundary_key": {"const": "service_role"}, "inline_policy_names": {"maxItems": 0}, "managed_policy_document_digest": {"$ref": "#/$defs/digest"}, "max_session_duration": {"const": 3600}, "path": {"const": "/"}, "permissions_boundary_arn": {"type": "string"}, "role_name": {"type": "string"}, "tags": {"type": "array"}, "trust_policy": {"$ref": "#/$defs/object"}, "trust_policy_digest": {"$ref": "#/$defs/digest"}}
