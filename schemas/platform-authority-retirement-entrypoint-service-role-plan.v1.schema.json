    "revocation": {"type": "object", "required": ["checkpoint", "executor_effective_authority_requirement", "executor_effective_authority_requirement_digest", "executor_policy", "executor_policy_digest", "forward_execution_permitted", "mutation_digest", "mutations", "operation_digest", "operations", "phase", "same_session_reuse_permitted"]},
