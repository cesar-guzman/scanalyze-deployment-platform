    "readback": {"type": "object", "required": ["api_action", "request", "sequence", "service", "target_arn"], "properties": {"api_action": {"type": "string"}, "request": {"$ref": "#/$defs/object"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 126}, "service": {"enum": ["iam", "lambda", "logs", "dynamodb", "kms"]}, "target_arn": {"type": "string"}, "retry_permitted": {"const": false}, "write_retry_permitted": {"const": false}}},
    "receipt_gate": {"type": "object", "required": ["accepted_create_table_call_count", "accepted_statuses", "accepted_update_pitr_call_count", "already_exact_mode", "checkpoint", "invocation_type", "main_role_activation_permitted", "payload", "qualified_function_arn", "receipt_contract_sha256", "receipt_sha256_required", "sdk_retry_mode"]}
