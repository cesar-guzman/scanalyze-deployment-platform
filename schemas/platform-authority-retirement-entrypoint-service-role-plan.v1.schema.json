    "factory_function": {"type": "object", "required": ["arn", "code_signing_config_arn", "create_request", "create_request_digest", "event_contract", "function_name", "immutable_version", "immutable_version_arn", "invocation_type", "normalized_configuration", "package_manifest", "package_manifest_digest", "preexisting_mode", "sdk_retry_mode", "signed_code", "tags"], "minProperties": 25},
