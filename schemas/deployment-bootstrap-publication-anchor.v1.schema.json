{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/deployment-bootstrap-publication-anchor.v1.schema.json",
  "title": "Deployment Bootstrap Publication Anchor v1",
  "description": "Minimal independently retrieved anchor for a bootstrap publication binding.",
  "type": "object",
  "required": ["schema_version", "deployment_id", "binding_digest"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1" },
    "deployment_id": { "type": "string", "pattern": "^dep_[0-9A-HJKMNP-TV-Z]{26}$" },
    "binding_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
