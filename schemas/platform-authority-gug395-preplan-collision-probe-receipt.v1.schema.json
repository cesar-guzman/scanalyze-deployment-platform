{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/platform-authority-gug395-preplan-collision-probe-receipt.v1.schema.json",
  "title": "GUG-376/GUG-395 dual-domain pre-plan collision probe receipt",
  "description": "Digest-only public evidence for a bounded dual-domain read-only collision probe. A durable blocked attempt is incomplete reconciliation evidence and leaves unprovable AWS/network counts and modeled cost null. A synthetic example remains blocked and schema validity never proves a live run, authorizes mutation or deployment, or changes production NO-GO.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "implementation_issue",
    "seed_issue",
    "downstream_consumer_issue",
    "status",
    "evidence_scope",
    "classification",
    "provider_implementation_gate",
    "source_commit_sha",
    "source_tree_sha",
    "preplan_seed_digest",
    "mutation_plan_digest",
    "target_catalog_digest",
    "expected_tag_contract_digest",
    "request_digest",
    "profile_binding_digest",
    "policy_set_digest",
    "budget_digest",
    "window_digest",
    "authority_session_digests",
    "identity_center_session_digests",
    "authority_snapshot_digests",
    "identity_center_snapshot_digests",
    "authority_facts_digest",
    "identity_center_facts_digest",
    "authority_classification",
    "identity_center_classification",
    "authority_collision_count",
    "identity_center_collision_count",
    "collision_count",
    "resource_counts_digest",
    "provider_evidence_digest",
    "transcript_digest",
    "evidence_manifest_digest",
    "provider_calls",
    "aws_calls",
    "session_bootstrap_attempts",
    "credential_vending_calls",
    "network_calls",
    "page_calls",
    "projected_response_bytes",
    "modeled_cost_usd_upper",
    "cost_status",
    "evidence_complete",
    "evidence_stable",
    "live_provider_evidence",
    "read_only",
    "reconciliation_only",
    "live_execution_ready",
    "aws_mutations",
    "deployment_authorized",
    "production",
    "two_human_status",
    "independent_approval_present",
    "production_status",
    "sealed_at",
    "receipt_digest"
  ],
  "properties": {
    "record_type": {
      "const": "scanalyze.platform_authority.gug395_preplan_collision_probe_receipt.v1"
    },
    "schema_version": { "const": 1 },
    "implementation_issue": { "const": "GUG-376" },
    "seed_issue": { "const": "GUG-395" },
    "downstream_consumer_issue": { "const": "GUG-365" },
    "status": {
      "enum": [
        "SYNTHETIC_CONTRACT_ONLY_BLOCKED",
        "LIVE_READ_ONLY_PROBE_RECORDED",
        "LIVE_READ_ONLY_PROBE_BLOCKED"
      ]
    },
    "evidence_scope": {
      "enum": [
        "SYNTHETIC_SCHEMA_EXAMPLE",
        "LIVE_PROVIDER_DIGEST_ONLY",
        "LIVE_ATTEMPT_DIGEST_ONLY"
      ]
    },
    "classification": { "$ref": "#/$defs/classification" },
    "provider_implementation_gate": {
      "enum": [
        "BLOCKED_SYNTHETIC_EVIDENCE",
        "READY_FOR_PROVIDER_IMPLEMENTATION",
        "BLOCKED_COLLISION",
        "BLOCKED_RECONCILIATION_REQUIRED"
      ]
    },
    "source_commit_sha": { "$ref": "#/$defs/gitSha" },
    "source_tree_sha": { "$ref": "#/$defs/gitSha" },
    "preplan_seed_digest": { "$ref": "#/$defs/digest" },
    "mutation_plan_digest": { "$ref": "#/$defs/digest" },
    "target_catalog_digest": { "$ref": "#/$defs/digest" },
    "expected_tag_contract_digest": { "$ref": "#/$defs/digest" },
    "request_digest": { "$ref": "#/$defs/digest" },
    "profile_binding_digest": { "$ref": "#/$defs/digest" },
    "policy_set_digest": { "$ref": "#/$defs/digest" },
    "budget_digest": { "$ref": "#/$defs/digest" },
    "window_digest": { "$ref": "#/$defs/digest" },
    "authority_session_digests": { "$ref": "#/$defs/digestList" },
    "identity_center_session_digests": { "$ref": "#/$defs/digestList" },
    "authority_snapshot_digests": { "$ref": "#/$defs/digestList" },
    "identity_center_snapshot_digests": { "$ref": "#/$defs/digestList" },
    "authority_facts_digest": { "$ref": "#/$defs/digest" },
    "identity_center_facts_digest": { "$ref": "#/$defs/digest" },
    "authority_classification": { "$ref": "#/$defs/classification" },
    "identity_center_classification": { "$ref": "#/$defs/classification" },
    "authority_collision_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "identity_center_collision_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "collision_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "resource_counts_digest": { "$ref": "#/$defs/digest" },
    "provider_evidence_digest": { "$ref": "#/$defs/digest" },
    "transcript_digest": { "$ref": "#/$defs/digest" },
    "evidence_manifest_digest": { "$ref": "#/$defs/digest" },
    "provider_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2048
    },
    "aws_calls": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 2048
    },
    "session_bootstrap_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "credential_vending_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "network_calls": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 2052
    },
    "page_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "projected_response_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777216
    },
    "modeled_cost_usd_upper": {
      "type": ["string", "null"],
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{9}$"
    },
    "cost_status": {
      "enum": [
        "SYNTHETIC_ZERO_COST",
        "WITHIN_REVIEWED_BOUND",
        "INCOMPLETE_UNBOUNDED"
      ]
    },
    "evidence_complete": { "type": "boolean" },
    "evidence_stable": { "type": "boolean" },
    "live_provider_evidence": { "type": "boolean" },
    "read_only": { "const": true },
    "reconciliation_only": { "type": "boolean" },
    "live_execution_ready": { "const": false },
    "aws_mutations": { "const": 0 },
    "deployment_authorized": { "const": false },
    "production": { "const": false },
    "two_human_status": { "const": "NOT_PROVEN" },
    "independent_approval_present": { "const": false },
    "production_status": { "const": "NO-GO" },
    "sealed_at": { "$ref": "#/$defs/timestamp" },
    "receipt_digest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "SYNTHETIC_CONTRACT_ONLY_BLOCKED" }
        }
      },
      "then": {
        "properties": {
          "evidence_scope": { "const": "SYNTHETIC_SCHEMA_EXAMPLE" },
          "classification": { "const": "UNCERTAIN_RECONCILE_ONLY" },
          "provider_implementation_gate": {
            "const": "BLOCKED_SYNTHETIC_EVIDENCE"
          },
          "authority_classification": {
            "const": "UNCERTAIN_RECONCILE_ONLY"
          },
          "identity_center_classification": {
            "const": "UNCERTAIN_RECONCILE_ONLY"
          },
          "authority_collision_count": { "const": 0 },
          "identity_center_collision_count": { "const": 0 },
          "collision_count": { "const": 0 },
          "authority_session_digests": { "$ref": "#/$defs/digestPair" },
          "identity_center_session_digests": {
            "$ref": "#/$defs/digestPair"
          },
          "authority_snapshot_digests": { "$ref": "#/$defs/digestPair" },
          "identity_center_snapshot_digests": {
            "$ref": "#/$defs/digestPair"
          },
          "provider_calls": { "const": 0 },
          "aws_calls": { "const": 0 },
          "session_bootstrap_attempts": { "const": 0 },
          "credential_vending_calls": { "const": 0 },
          "network_calls": { "const": 0 },
          "page_calls": { "const": 0 },
          "projected_response_bytes": { "const": 0 },
          "modeled_cost_usd_upper": { "const": "0.000000000" },
          "cost_status": { "const": "SYNTHETIC_ZERO_COST" },
          "evidence_complete": { "const": false },
          "evidence_stable": { "const": false },
          "live_provider_evidence": { "const": false },
          "reconciliation_only": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "LIVE_READ_ONLY_PROBE_RECORDED" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evidence_scope": { "const": "LIVE_PROVIDER_DIGEST_ONLY" },
          "authority_session_digests": { "$ref": "#/$defs/digestPair" },
          "identity_center_session_digests": {
            "$ref": "#/$defs/digestPair"
          },
          "authority_snapshot_digests": { "$ref": "#/$defs/digestPair" },
          "identity_center_snapshot_digests": {
            "$ref": "#/$defs/digestPair"
          },
          "provider_calls": { "minimum": 1 },
          "aws_calls": { "type": "integer", "minimum": 1 },
          "session_bootstrap_attempts": { "const": 4 },
          "network_calls": { "type": "integer", "minimum": 1 },
          "modeled_cost_usd_upper": { "type": "string" },
          "cost_status": { "const": "WITHIN_REVIEWED_BOUND" },
          "live_provider_evidence": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "LIVE_READ_ONLY_PROBE_BLOCKED" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evidence_scope": { "const": "LIVE_ATTEMPT_DIGEST_ONLY" },
          "classification": { "const": "UNCERTAIN_RECONCILE_ONLY" },
          "provider_implementation_gate": {
            "const": "BLOCKED_RECONCILIATION_REQUIRED"
          },
          "aws_calls": { "type": "null" },
          "network_calls": { "type": "null" },
          "modeled_cost_usd_upper": { "type": "null" },
          "cost_status": { "const": "INCOMPLETE_UNBOUNDED" },
          "evidence_complete": { "const": false },
          "evidence_stable": { "const": false },
          "live_provider_evidence": { "const": false },
          "reconciliation_only": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "LIVE_READ_ONLY_PROBE_RECORDED" },
          "classification": {
            "const": "ABSENT_READY_FOR_PROVIDER_IMPLEMENTATION"
          }
        },
        "required": ["status", "classification"]
      },
      "then": {
        "properties": {
          "provider_implementation_gate": {
            "const": "READY_FOR_PROVIDER_IMPLEMENTATION"
          },
          "authority_classification": {
            "const": "ABSENT_READY_FOR_PROVIDER_IMPLEMENTATION"
          },
          "identity_center_classification": {
            "const": "ABSENT_READY_FOR_PROVIDER_IMPLEMENTATION"
          },
          "authority_collision_count": { "const": 0 },
          "identity_center_collision_count": { "const": 0 },
          "collision_count": { "const": 0 },
          "evidence_complete": { "const": true },
          "evidence_stable": { "const": true },
          "reconciliation_only": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "LIVE_READ_ONLY_PROBE_RECORDED" },
          "classification": { "const": "COLLISION_BLOCKED_NO_MUTATION" }
        },
        "required": ["status", "classification"]
      },
      "then": {
        "properties": {
          "provider_implementation_gate": { "const": "BLOCKED_COLLISION" },
          "collision_count": { "minimum": 1 },
          "evidence_complete": { "const": true },
          "evidence_stable": { "const": true },
          "reconciliation_only": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "LIVE_READ_ONLY_PROBE_RECORDED" },
          "classification": { "const": "UNCERTAIN_RECONCILE_ONLY" }
        },
        "required": ["status", "classification"]
      },
      "then": {
        "properties": {
          "provider_implementation_gate": {
            "const": "BLOCKED_RECONCILIATION_REQUIRED"
          },
          "evidence_complete": { "const": false },
          "evidence_stable": { "const": false },
          "reconciliation_only": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "LIVE_READ_ONLY_PROBE_RECORDED",
              "LIVE_READ_ONLY_PROBE_BLOCKED"
            ]
          },
          "authority_classification": {
            "const": "COLLISION_BLOCKED_NO_MUTATION"
          }
        },
        "required": ["status", "authority_classification"]
      },
      "then": {
        "properties": {
          "authority_collision_count": { "minimum": 1 }
        }
      },
      "else": {
        "properties": {
          "authority_collision_count": { "const": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "LIVE_READ_ONLY_PROBE_RECORDED",
              "LIVE_READ_ONLY_PROBE_BLOCKED"
            ]
          },
          "identity_center_classification": {
            "const": "COLLISION_BLOCKED_NO_MUTATION"
          }
        },
        "required": ["status", "identity_center_classification"]
      },
      "then": {
        "properties": {
          "identity_center_collision_count": { "minimum": 1 }
        }
      },
      "else": {
        "properties": {
          "identity_center_collision_count": { "const": 0 }
        }
      }
    }
  ],
  "$defs": {
    "classification": {
      "enum": [
        "ABSENT_READY_FOR_PROVIDER_IMPLEMENTATION",
        "COLLISION_BLOCKED_NO_MUTATION",
        "UNCERTAIN_RECONCILE_ONLY"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digestList": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "digestPair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
