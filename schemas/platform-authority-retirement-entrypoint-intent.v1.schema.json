{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/platform-authority-retirement-entrypoint-intent.v1.schema.json",
  "title": "GUG-363 Retirement Entrypoint Materialization Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "schema_version", "implementation_issue", "live_issue",
    "environment", "production", "deployment_authorized", "authorization_mode",
    "two_human_status", "independent_approval_present", "target", "source",
    "artifact_signing_contract", "artifact_signing_contract_digest",
    "artifact_signing_evidence_digest", "gug363_pre_function_binding_sha256",
    "parameters", "owner_authorization_sha256",
    "single_operator_exception_digest", "intent_digest"
  ],
  "properties": {
    "record_type": { "const": "scanalyze.platform_authority.retirement_entrypoint_intent.v1" },
    "schema_version": { "const": 1 },
    "implementation_issue": { "const": "GUG-363" },
    "live_issue": { "const": "GUG-357" },
    "environment": { "const": "synthetic-non-production" },
    "production": { "const": false },
    "deployment_authorized": { "const": false },
    "authorization_mode": { "const": "SINGLE_OPERATOR_NONPROD_EXCEPTION" },
    "two_human_status": { "const": "NOT_PROVEN" },
    "independent_approval_present": { "const": false },
    "target": { "$ref": "#/$defs/target" },
    "source": { "$ref": "#/$defs/source" },
    "artifact_signing_contract": { "$ref": "#/$defs/artifact_signing_contract" },
    "artifact_signing_contract_digest": { "$ref": "#/$defs/digest" },
    "artifact_signing_evidence_digest": {
      "description": "Digest of the normalized Signer, versioned S3, and Lambda CSC provider-fact projection implied by the contract and refreshed read-only before use; it never authorizes signing or upload mutations.",
      "$ref": "#/$defs/digest"
    },
    "gug363_pre_function_binding_sha256": {
      "description": "Domain-separated binding of the full source record, signing-contract digest, and durable function inputs only; excludes every exception-window and private-projection value.",
      "$ref": "#/$defs/digest"
    },
    "parameters": { "$ref": "#/$defs/parameters" },
    "owner_authorization_sha256": { "$ref": "#/$defs/digest" },
    "single_operator_exception_digest": { "$ref": "#/$defs/digest" },
    "intent_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "code_sha256": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_account_id", "region", "stack_name",
        "cloudformation_service_role_arn"
      ],
      "properties": {
        "authority_account_id": { "const": "042360977644" },
        "region": { "const": "us-east-1" },
        "stack_name": { "const": "scanalyze-platform-authority-gug357-retirement-entrypoint" },
        "cloudformation_service_role_arn": {
          "const": "arn:aws:iam::042360977644:role/scanalyze-platform-authority-gug363-cfn-materializer"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "template_path", "template_sha256"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "template_path": { "const": "bootstrap/cfn-platform-authority-change-set-retirement-ledger.yaml" },
        "template_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "artifact_signing_contract": {
      "description": "Binds the unsigned GUG-215 source ZIP to a distinct pre-existing AWS Signer destination. CloudFormation may consume only signed_destination.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "unsigned_source", "signer", "signed_destination",
        "code_signing_config"
      ],
      "properties": {
        "contract_version": { "const": 1 },
        "unsigned_source": { "$ref": "#/$defs/unsigned_source" },
        "signer": { "$ref": "#/$defs/signer" },
        "signed_destination": { "$ref": "#/$defs/signed_destination" },
        "code_signing_config": { "$ref": "#/$defs/code_signing_config" }
      }
    },
    "unsigned_source": {
      "description": "Unsigned GUG-215 package manifest/archive provenance and exact versioned S3 signing source only. This object is never a CloudFormation BrokerArtifact parameter source.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type", "work_package", "manifest_digest", "archive_sha256",
        "lambda_code_sha256", "archive_size_bytes", "bucket", "key",
        "version_id", "sse_algorithm", "sse_kms_key_arn"
      ],
      "properties": {
        "artifact_type": { "const": "scanalyze.platform_authority.change_set_retirement_package.v1" },
        "work_package": { "const": "GUG-215" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "archive_sha256": { "$ref": "#/$defs/raw_digest" },
        "lambda_code_sha256": { "$ref": "#/$defs/code_sha256" },
        "archive_size_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "bucket": { "$ref": "#/$defs/bucket" },
        "key": { "$ref": "#/$defs/unsigned_key" },
        "version_id": { "$ref": "#/$defs/s3_version" },
        "sse_algorithm": { "const": "aws:kms" },
        "sse_kms_key_arn": { "$ref": "#/$defs/kms_key_arn" }
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id", "status", "job_owner", "job_invoker", "platform_id",
        "profile_name", "profile_version_id", "profile_version_arn",
        "signature_expires_at"
      ],
      "properties": {
        "job_id": { "$ref": "#/$defs/job_id" },
        "status": { "const": "Succeeded" },
        "job_owner": { "const": "042360977644" },
        "job_invoker": { "const": "042360977644" },
        "platform_id": { "const": "AWSLambda-SHA384-ECDSA" },
        "profile_name": { "$ref": "#/$defs/profile_name" },
        "profile_version_id": { "$ref": "#/$defs/profile_version_id" },
        "profile_version_arn": { "$ref": "#/$defs/profile_version_arn" },
        "signature_expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "signed_destination": {
      "description": "Distinct AWS Signer destination whose bytes, version, and digests are the only values eligible for CloudFormation BrokerArtifact parameters.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket", "key", "version_id", "archive_sha256", "lambda_code_sha256",
        "archive_size_bytes", "sse_algorithm", "sse_kms_key_arn"
      ],
      "properties": {
        "bucket": { "$ref": "#/$defs/bucket" },
        "key": { "$ref": "#/$defs/signed_key" },
        "version_id": { "$ref": "#/$defs/s3_version" },
        "archive_sha256": { "$ref": "#/$defs/raw_digest" },
        "lambda_code_sha256": { "$ref": "#/$defs/code_sha256" },
        "archive_size_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "sse_algorithm": { "const": "aws:kms" },
        "sse_kms_key_arn": { "$ref": "#/$defs/kms_key_arn" }
      }
    },
    "code_signing_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arn", "allowed_signing_profile_version_arns",
        "untrusted_artifact_on_deployment"
      ],
      "properties": {
        "arn": { "$ref": "#/$defs/code_signing_config_arn" },
        "allowed_signing_profile_version_arns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profile_version_arn" }
        },
        "untrusted_artifact_on_deployment": { "const": "Enforce" }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AuthorizationMode", "AuthorityAccountId", "ChangeSetName", "RetirementId",
        "ExpectedTemplateSha256", "ExpectedEvidenceSha256", "ExpectedBrokerPolicySha256",
        "PrivateParameterProjectionSha256",
        "BrokerArtifactBucket", "BrokerArtifactKey", "BrokerArtifactVersion",
        "BrokerArtifactCodeSha256", "BrokerCodeSigningConfigArn", "BrokerRuntimeVersionArn",
        "BrokerVersionBindingSha256", "IdentityStoreArn", "IdentityCenterInstanceArn",
        "IdentityCenterApplicationArn", "IdentityCenterRedirectUri",
        "ClassifierIdentityStoreUserId", "ApproverIdentityStoreUserId",
        "ClassifierAssignmentSha256", "ApproverAssignmentSha256",
        "ClassifierInvokerPolicySha256", "ApproverInvokerPolicySha256",
        "ClassifierProofPolicySha256", "ApproverProofPolicySha256",
        "IdentityCenterApplicationActorPolicySha256", "ClassifierPermissionSetRoleArn",
        "ApproverPermissionSetRoleArn", "SingleOperatorOwnerAuthorizationSha256",
        "SingleOperatorExpectedAuthorizationSha256", "SingleOperatorExceptionCreatedAt",
        "SingleOperatorExceptionNotBefore", "SingleOperatorExceptionExpiresAt"
      ],
      "properties": {
        "AuthorizationMode": { "const": "SINGLE_OPERATOR_NONPROD_EXCEPTION" },
        "AuthorityAccountId": { "const": "042360977644" },
        "ChangeSetName": { "type": "string", "pattern": "^scanalyze-platform-authority-bootstrap-[0-9]{14}$" },
        "RetirementId": { "type": "string", "pattern": "^gug215#sha256:[0-9a-f]{64}$" },
        "ExpectedTemplateSha256": { "$ref": "#/$defs/digest" },
        "ExpectedEvidenceSha256": { "$ref": "#/$defs/digest" },
        "ExpectedBrokerPolicySha256": { "$ref": "#/$defs/digest" },
        "PrivateParameterProjectionSha256": {
          "description": "Domain-separated digest of the canonical ordered private parameter projection excluding this self-referential parameter.",
          "$ref": "#/$defs/digest"
        },
        "BrokerArtifactBucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
        "BrokerArtifactKey": { "$ref": "#/$defs/signed_key" },
        "BrokerArtifactVersion": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "BrokerArtifactCodeSha256": { "$ref": "#/$defs/code_sha256" },
        "BrokerCodeSigningConfigArn": { "$ref": "#/$defs/code_signing_config_arn" },
        "BrokerRuntimeVersionArn": { "type": "string", "pattern": "^arn:aws:lambda:us-east-1::runtime:[0-9a-f]{64}$" },
        "BrokerVersionBindingSha256": { "$ref": "#/$defs/digest" },
        "IdentityStoreArn": { "type": "string", "pattern": "^arn:aws:identitystore::042360977644:identitystore/d-[a-z0-9]{10,}$" },
        "IdentityCenterInstanceArn": { "type": "string", "pattern": "^arn:aws:sso:::instance/ssoins-[A-Za-z0-9]{16}$" },
        "IdentityCenterApplicationArn": { "type": "string", "pattern": "^arn:aws:sso::042360977644:application/ssoins-[A-Za-z0-9]{16}/apl-[A-Za-z0-9]{16}$" },
        "IdentityCenterRedirectUri": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]{4,5}/callback$" },
        "ClassifierIdentityStoreUserId": { "type": "string", "pattern": "^([0-9a-f]{10}-)?[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$" },
        "ApproverIdentityStoreUserId": { "type": "string", "pattern": "^([0-9a-f]{10}-)?[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$" },
        "ClassifierAssignmentSha256": { "$ref": "#/$defs/digest" },
        "ApproverAssignmentSha256": { "$ref": "#/$defs/digest" },
        "ClassifierInvokerPolicySha256": { "$ref": "#/$defs/digest" },
        "ApproverInvokerPolicySha256": { "$ref": "#/$defs/digest" },
        "ClassifierProofPolicySha256": { "$ref": "#/$defs/digest" },
        "ApproverProofPolicySha256": { "$ref": "#/$defs/digest" },
        "IdentityCenterApplicationActorPolicySha256": { "$ref": "#/$defs/digest" },
        "ClassifierPermissionSetRoleArn": { "type": "string", "pattern": "^arn:aws:iam::042360977644:role/aws-reserved/sso\\.amazonaws\\.com/([a-z0-9-]+/)?AWSReservedSSO_ScanalyzeAuthorityRetireClass_[0-9a-fA-F]{16}$" },
        "ApproverPermissionSetRoleArn": { "type": "string", "pattern": "^arn:aws:iam::042360977644:role/aws-reserved/sso\\.amazonaws\\.com/([a-z0-9-]+/)?AWSReservedSSO_ScanalyzeAuthorityRetireApprove_[0-9a-fA-F]{16}$" },
        "SingleOperatorOwnerAuthorizationSha256": { "$ref": "#/$defs/digest" },
        "SingleOperatorExpectedAuthorizationSha256": { "$ref": "#/$defs/digest" },
        "SingleOperatorExceptionCreatedAt": { "$ref": "#/$defs/timestamp" },
        "SingleOperatorExceptionNotBefore": { "$ref": "#/$defs/timestamp" },
        "SingleOperatorExceptionExpiresAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "raw_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bucket": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
    },
    "s3_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u0020\\u007f]+$"
    },
    "unsigned_key": {
      "type": "string",
      "pattern": "^scanalyze/platform-authority/gug-215/unsigned/[0-9a-f]{40}/scanalyze-gug215-change-set-retirement-broker\\.zip$"
    },
    "signed_key": {
      "type": "string",
      "pattern": "^scanalyze/platform-authority/gug-215/signed/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.zip$"
    },
    "job_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "profile_name": { "type": "string", "pattern": "^[A-Za-z0-9_]{2,64}$" },
    "profile_version_id": { "type": "string", "pattern": "^[A-Za-z0-9]{10}$" },
    "profile_version_arn": {
      "type": "string",
      "pattern": "^arn:aws:signer:us-east-1:042360977644:/signing-profiles/[A-Za-z0-9_]{2,64}/[A-Za-z0-9]{10}$"
    },
    "kms_key_arn": {
      "type": "string",
      "pattern": "^arn:aws:kms:us-east-1:042360977644:key/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "code_signing_config_arn": {
      "type": "string",
      "pattern": "^arn:aws:lambda:us-east-1:042360977644:code-signing-config:csc-[A-Za-z0-9]+$"
    }
  }
}
