{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/platform-authority-gug395-preplan-seed-receipt.v1.schema.json",
  "title": "GUG-395 sanitized offline pre-plan seed receipt",
  "description": "Digest-only public shape for a blocked synthetic example or a source-capability-gated private offline pre-plan seed. Schema validity alone never proves materialization and never authorizes live execution, deployment, or production.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "implementation_issue",
    "parent_issue",
    "discovery_issue",
    "live_readonly_issue",
    "downstream_consumer_issue",
    "status",
    "evidence_scope",
    "verified_source_capability_present",
    "source_commit_sha",
    "source_tree_sha",
    "source_verification_digest",
    "repository_tree_entries_digest",
    "source_manifest_digest",
    "bound_values_digest",
    "operation_catalog_digest",
    "phase_catalog_digest",
    "provider_slot_catalog_digest",
    "unsigned_package_set_digest",
    "private_seed_digest",
    "owner_decision_count",
    "derived_binding_count",
    "bound_value_count",
    "phase_count",
    "operation_count",
    "provider_slot_count",
    "missing_provider_route_count",
    "routed_provider_slot_count",
    "connected_preflight_required",
    "exact_live_plan_materialized",
    "live_execution_ready",
    "read_only",
    "aws_calls",
    "aws_mutations",
    "deployment_authorized",
    "production",
    "two_human_status",
    "independent_approval_present",
    "production_status",
    "created_at",
    "receipt_digest"
  ],
  "properties": {
    "record_type": {
      "const": "scanalyze.platform_authority.gug395_preplan_seed_receipt.v1"
    },
    "schema_version": { "const": 1 },
    "implementation_issue": { "const": "GUG-395" },
    "parent_issue": { "const": "GUG-376" },
    "discovery_issue": { "const": "GUG-393" },
    "live_readonly_issue": { "const": "GUG-392" },
    "downstream_consumer_issue": { "const": "GUG-365" },
    "status": {
      "enum": [
        "SYNTHETIC_CONTRACT_ONLY_BLOCKED",
        "PRIVATE_PREPLAN_SEED_MATERIALIZED"
      ]
    },
    "evidence_scope": {
      "enum": [
        "SYNTHETIC_SCHEMA_EXAMPLE",
        "OFFLINE_DIGEST_ONLY"
      ]
    },
    "verified_source_capability_present": { "type": "boolean" },
    "source_commit_sha": { "$ref": "#/$defs/gitSha" },
    "source_tree_sha": { "$ref": "#/$defs/gitSha" },
    "source_verification_digest": { "$ref": "#/$defs/digest" },
    "repository_tree_entries_digest": { "$ref": "#/$defs/digest" },
    "source_manifest_digest": { "$ref": "#/$defs/digest" },
    "bound_values_digest": { "$ref": "#/$defs/digest" },
    "operation_catalog_digest": { "$ref": "#/$defs/digest" },
    "phase_catalog_digest": { "$ref": "#/$defs/digest" },
    "provider_slot_catalog_digest": { "$ref": "#/$defs/digest" },
    "unsigned_package_set_digest": { "$ref": "#/$defs/digest" },
    "private_seed_digest": { "$ref": "#/$defs/digest" },
    "owner_decision_count": { "const": 14 },
    "derived_binding_count": { "const": 2 },
    "bound_value_count": { "const": 16 },
    "phase_count": { "const": 9 },
    "operation_count": { "const": 30 },
    "provider_slot_count": { "const": 22 },
    "missing_provider_route_count": { "const": 14 },
    "routed_provider_slot_count": { "const": 8 },
    "connected_preflight_required": { "const": true },
    "exact_live_plan_materialized": { "const": false },
    "live_execution_ready": { "const": false },
    "read_only": { "const": true },
    "aws_calls": { "const": 0 },
    "aws_mutations": { "const": 0 },
    "deployment_authorized": { "const": false },
    "production": { "const": false },
    "two_human_status": { "const": "NOT_PROVEN" },
    "independent_approval_present": { "const": false },
    "production_status": { "const": "NO-GO" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "receipt_digest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "SYNTHETIC_CONTRACT_ONLY_BLOCKED" }
        }
      },
      "then": {
        "properties": {
          "evidence_scope": { "const": "SYNTHETIC_SCHEMA_EXAMPLE" },
          "verified_source_capability_present": { "const": false }
        }
      },
      "else": {
        "properties": {
          "evidence_scope": { "const": "OFFLINE_DIGEST_ONLY" },
          "verified_source_capability_present": { "const": true }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
