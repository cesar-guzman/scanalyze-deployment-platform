{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/contract-resolution.v3.schema.json",
  "title": "Scanalyze verified contract resolution v3",
  "description": "Target-bound Terraform and externally anchored ACCOUNT_READY evidence.",
  "type": "object",
  "required": [
    "schema_version",
    "consumer_layer",
    "customer_id",
    "deployment_id",
    "aws_account_id",
    "region",
    "release_version",
    "release_digest",
    "resolved_at",
    "max_contract_age_seconds",
    "required_contracts",
    "resolution_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "3" },
    "consumer_layer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "customer_id": {
      "type": "string",
      "pattern": "^cust_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "deployment_id": {
      "type": "string",
      "pattern": "^dep_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "aws_account_id": { "type": "string", "pattern": "^[0-9]{12}$" },
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]+$"
    },
    "release_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "release_digest": { "$ref": "#/$defs/sha256" },
    "resolved_at": { "type": "string", "format": "date-time" },
    "max_contract_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "required_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/terraform_contract_evidence" },
          { "$ref": "#/$defs/account_ready_evidence" }
        ]
      }
    },
    "resolution_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "account_ready_evidence": {
      "type": "object",
      "required": ["contract_id", "contract"],
      "additionalProperties": false,
      "properties": {
        "contract_id": { "const": "account-ready/v2" },
        "contract": { "type": "object", "minProperties": 1 }
      }
    },
    "terraform_contract_evidence": {
      "type": "object",
      "required": [
        "schema_version",
        "customer_id",
        "deployment_id",
        "aws_account_id",
        "region",
        "scope",
        "layer",
        "producer",
        "release_version",
        "release_digest",
        "output_schema_version",
        "outputs",
        "contract_digest",
        "produced_at",
        "terraform_workspace",
        "state_key",
        "module_source_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "2" },
        "customer_id": {
          "type": "string",
          "pattern": "^cust_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "deployment_id": {
          "type": "string",
          "pattern": "^dep_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "aws_account_id": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "region": {
          "oneOf": [
            { "const": "global" },
            {
              "type": "string",
              "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]+$"
            }
          ]
        },
        "scope": { "enum": ["global", "regional"] },
        "layer": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "producer": {
          "type": "string",
          "pattern": "^roots/[a-z][a-z0-9-]*$"
        },
        "release_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        },
        "release_digest": { "$ref": "#/$defs/sha256" },
        "output_schema_version": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*/v[1-9][0-9]*$"
        },
        "outputs": { "type": "object", "minProperties": 1 },
        "contract_digest": { "$ref": "#/$defs/sha256" },
        "produced_at": { "type": "string", "format": "date-time" },
        "terraform_workspace": { "const": "default" },
        "state_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "module_source_digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
