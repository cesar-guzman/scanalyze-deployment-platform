{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/platform-authority-gug376-identity-center-inventory-receipt.v1.schema.json",
  "title": "GUG-385 digest-only public Identity Center inventory receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "status", "live_status", "classification", "policy_binding_digest", "target_digest", "facts_digest", "snapshot_digests", "surface_counts", "snapshot_count", "stable", "read_only", "aws_calls", "aws_mutations", "two_human_status", "independent_approval_present", "deployment_authorized", "production_status", "receipt_digest"],
  "properties": {
    "record_type": { "const": "scanalyze.platform_authority.gug376_identity_center_inventory_receipt.v1" },
    "status": { "const": "STOP_LIVE_ORCHESTRATOR_NOT_IMPLEMENTED" },
    "live_status": { "const": "IDENTITY_CENTER_INVENTORY_LIVE_NOT_PROVEN" },
    "classification": { "enum": ["ABSENT_READY", "EXACT_PRESENT_NO_TOUCH", "DRIFT_BLOCKED_NO_REPAIR", "NOT_AUTHORIZED", "UNCERTAIN_RECONCILE_ONLY"] },
    "policy_binding_digest": { "$ref": "#/$defs/digest" },
    "target_digest": { "$ref": "#/$defs/digest" },
    "facts_digest": { "$ref": "#/$defs/digest" },
    "snapshot_digests": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
    "surface_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["instances", "applications", "permission_sets", "assignments", "provisioning", "target_accounts", "operators"],
      "properties": { "instances": { "$ref": "#/$defs/count" }, "applications": { "$ref": "#/$defs/count" }, "permission_sets": { "$ref": "#/$defs/count" }, "assignments": { "$ref": "#/$defs/count" }, "provisioning": { "$ref": "#/$defs/count" }, "target_accounts": { "$ref": "#/$defs/count" }, "operators": { "$ref": "#/$defs/count" } }
    },
    "snapshot_count": { "type": "integer", "minimum": 1, "maximum": 2 },
    "stable": { "type": "boolean" },
    "read_only": { "const": true },
    "aws_calls": { "const": 0 },
    "aws_mutations": { "const": 0 },
    "two_human_status": { "const": "NOT_PROVEN" },
    "independent_approval_present": { "const": false },
    "deployment_authorized": { "const": false },
    "production_status": { "const": "NO-GO" },
    "receipt_digest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [{ "if": { "properties": { "classification": { "enum": ["ABSENT_READY", "EXACT_PRESENT_NO_TOUCH", "DRIFT_BLOCKED_NO_REPAIR"] } } }, "then": { "properties": { "snapshot_count": { "const": 2 }, "stable": { "const": true } } } }, { "if": { "properties": { "classification": { "enum": ["NOT_AUTHORIZED", "UNCERTAIN_RECONCILE_ONLY"] } } }, "then": { "properties": { "stable": { "const": false } } } }, { "if": { "properties": { "snapshot_count": { "const": 1 } } }, "then": { "properties": { "snapshot_digests": { "minItems": 1, "maxItems": 1 } } } }, { "if": { "properties": { "snapshot_count": { "const": 2 } } }, "then": { "properties": { "snapshot_digests": { "minItems": 2, "maxItems": 2 } } } }],
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "count": { "type": ["integer", "null"], "minimum": 0 } }
}
