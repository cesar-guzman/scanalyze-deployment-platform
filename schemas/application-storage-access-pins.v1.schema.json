{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/application-storage-access-pins.v1.schema.json",
  "title": "Application storage access-pins v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "const": "foundation"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "transition_digest",
        "edge_envelope_digest",
        "edge_locator_digest",
        "edge_readback_digest",
        "release_digest",
        "release_version"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "const": "oac"
        },
        "transition_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "edge_envelope_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "edge_locator_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "edge_readback_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "release_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "release_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        }
      }
    }
  ]
}
