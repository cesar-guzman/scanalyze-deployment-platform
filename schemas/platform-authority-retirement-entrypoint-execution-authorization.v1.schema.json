{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/platform-authority-retirement-entrypoint-execution-authorization.v1.schema.json",
  "title": "GUG-363 Retirement Entrypoint One-Shot Execution Authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "schema_version", "issue_id", "environment", "production",
    "deployment_authorized", "authorization_mode", "two_human_status",
    "independent_approval_present", "target", "plan_digest",
    "create_stack_request_digest", "operation_list_digest",
    "artifact_signing_contract_digest", "artifact_signing_evidence_digest",
    "gug363_pre_function_binding_sha256", "function_configurator_contract_digest",
    "function_configuration_request_projection_digest",
    "broker_function_evidence_digest", "function_configurator_checkpoint_digest",
    "function_configurator_authority_status", "function_configurator_authority_ended_at",
    "activator_checkpoint_digest", "activator_authority_status",
    "activator_authority_ended_at",
    "owner_authorization_sha256", "caller_arn_sha256", "caller_user_id_sha256",
    "live_checkpoint_digest",
    "live_before_state_digest", "service_role_evidence_digest",
    "service_role_evidence_scope", "service_role_evidence_collected_at",
    "post_activator_bundle_readback_complete",
    "operator_authority_evidence_digest",
    "allowed_action", "forbidden_actions", "max_attempts", "not_before",
    "expires_at", "authorization_digest"
  ],
  "properties": {
    "record_type": { "const": "scanalyze.platform_authority.retirement_entrypoint_execution_authorization.v1" },
    "schema_version": { "const": 1 },
    "issue_id": { "const": "GUG-357" },
    "environment": { "const": "synthetic-non-production" },
    "production": { "const": false },
    "deployment_authorized": { "const": true },
    "authorization_mode": { "const": "SINGLE_OPERATOR_NONPROD_EXCEPTION" },
    "two_human_status": { "const": "NOT_PROVEN" },
    "independent_approval_present": { "const": false },
    "target": { "$ref": "#/$defs/target" },
    "plan_digest": {
      "description": "Binds the exact plan, including its ordered 35-row CloudFormation parameter projection and visible private projection digest.",
      "$ref": "#/$defs/digest"
    },
    "create_stack_request_digest": { "$ref": "#/$defs/digest" },
    "operation_list_digest": { "$ref": "#/$defs/digest" },
    "artifact_signing_contract_digest": { "$ref": "#/$defs/digest" },
    "artifact_signing_evidence_digest": { "$ref": "#/$defs/digest" },
    "gug363_pre_function_binding_sha256": { "$ref": "#/$defs/digest" },
    "function_configurator_contract_digest": { "$ref": "#/$defs/digest" },
    "function_configuration_request_projection_digest": { "$ref": "#/$defs/digest" },
    "broker_function_evidence_digest": { "$ref": "#/$defs/digest" },
    "function_configurator_checkpoint_digest": { "$ref": "#/$defs/digest" },
    "function_configurator_authority_status": { "const": "EXPIRED_OR_REVOKED" },
    "function_configurator_authority_ended_at": { "$ref": "#/$defs/timestamp" },
    "activator_checkpoint_digest": { "$ref": "#/$defs/digest" },
    "activator_authority_status": { "const": "EXPIRED_OR_REVOKED" },
    "activator_authority_ended_at": { "$ref": "#/$defs/timestamp" },
    "owner_authorization_sha256": { "$ref": "#/$defs/digest" },
    "caller_arn_sha256": { "$ref": "#/$defs/digest" },
    "caller_user_id_sha256": { "$ref": "#/$defs/digest" },
    "live_checkpoint_digest": { "$ref": "#/$defs/digest" },
    "live_before_state_digest": { "$ref": "#/$defs/digest" },
    "service_role_evidence_digest": { "$ref": "#/$defs/digest" },
    "service_role_evidence_scope": { "const": "POST_ACTIVATOR_FULL_BUNDLE_READBACK" },
    "service_role_evidence_collected_at": { "$ref": "#/$defs/timestamp" },
    "post_activator_bundle_readback_complete": { "const": true },
    "operator_authority_evidence_digest": { "$ref": "#/$defs/digest" },
    "allowed_action": { "const": "cloudformation:CreateStack" },
    "forbidden_actions": { "$ref": "#/$defs/prohibited_operations" },
    "max_attempts": { "const": 1 },
    "not_before": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "authorization_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_account_id", "region", "stack_name",
        "cloudformation_service_role_arn"
      ],
      "properties": {
        "authority_account_id": { "const": "042360977644" },
        "region": { "const": "us-east-1" },
        "stack_name": { "const": "scanalyze-platform-authority-gug357-retirement-entrypoint" },
        "cloudformation_service_role_arn": {
          "const": "arn:aws:iam::042360977644:role/scanalyze-platform-authority-gug363-cfn-materializer"
        }
      }
    },
    "prohibited_operations": {
      "type": "array",
      "prefixItems": [
        { "const": "cloudformation:CreateChangeSet" },
        { "const": "cloudformation:DeleteChangeSet" },
        { "const": "cloudformation:DeleteStack" },
        { "const": "cloudformation:ExecuteChangeSet" },
        { "const": "cloudformation:UpdateStack" },
        { "const": "lambda:InvokeFunction" },
        { "const": "lambda:InvokeFunctionUrl" },
        { "const": "lambda:CreateCodeSigningConfig" },
        { "const": "lambda:DeleteCodeSigningConfig" },
        { "const": "lambda:DeleteFunctionCodeSigningConfig" },
        { "const": "lambda:PutFunctionCodeSigningConfig" },
        { "const": "lambda:UpdateCodeSigningConfig" },
        { "const": "signer:StartSigningJob" },
        { "const": "s3:CopyObject" },
        { "const": "s3:PutObject" },
        { "const": "terraform:apply" },
        { "const": "terraform:import" }
      ],
      "items": false,
      "minItems": 17,
      "maxItems": 17
    }
  }
}
