{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/platform-authority-retirement-ledger-factory-package.v1.schema.json",
  "title": "GUG-365 deterministic ledger-factory package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type", "schema_version", "work_package", "production",
    "source_commit", "archive_name", "archive_format", "archive_sha256",
    "lambda_code_sha256", "archive_size_bytes", "handler", "runtime",
    "architecture", "runtime_dependency_mode", "runtime_version_arn_sha256",
    "environment", "entries", "deployment_authorized", "production_status",
    "manifest_digest"
  ],
  "properties": {
    "artifact_type": {"const": "scanalyze.platform_authority.retirement_ledger_factory_package.v1"},
    "schema_version": {"const": 1},
    "work_package": {"const": "GUG-365"},
    "production": {"const": false},
    "source_commit": {"$ref": "#/$defs/commit"},
    "archive_name": {"const": "scanalyze-gug365-retirement-ledger-factory.zip"},
    "archive_format": {"const": "ZIP_STORED_FIXED_METADATA"},
    "archive_sha256": {"$ref": "#/$defs/hex_digest"},
    "lambda_code_sha256": {"$ref": "#/$defs/lambda_code_sha256"},
    "archive_size_bytes": {"type": "integer", "minimum": 1},
    "handler": {"const": "tooling.platform_authority_retirement_ledger_factory.handler"},
    "runtime": {"const": "python3.12"},
    "architecture": {"const": "x86_64"},
    "runtime_dependency_mode": {"const": "AWS_MANAGED_RUNTIME_PINNED"},
    "runtime_version_arn_sha256": {"$ref": "#/$defs/digest"},
    "environment": {"const": {}},
    "entries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"enum": ["tooling/__init__.py", "tooling/platform_authority_retirement_ledger_factory.py"]},
          "sha256": {"$ref": "#/$defs/hex_digest"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      },
      "allOf": [
        {"contains": {"properties": {"path": {"const": "tooling/__init__.py"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"path": {"const": "tooling/platform_authority_retirement_ledger_factory.py"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "deployment_authorized": {"const": false},
    "production_status": {"const": "NO-GO"},
    "manifest_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hex_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lambda_code_sha256": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"}
  }
}
