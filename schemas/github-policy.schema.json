{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanalyze.dev/schemas/github-policy.v1.schema.json",
  "title": "Scanalyze GitHub Repository Governance Policy v1",
  "description": "Repository-global, client-independent required-check contract. Real client inventory and credentials are prohibited.",
  "type": "object",
  "required": [
    "schema_version",
    "scope",
    "default_branch",
    "required_status_checks",
    "enforce_admins",
    "required_pull_request_reviews",
    "required_conversation_resolution",
    "allow_force_pushes",
    "allow_deletions",
    "independent_review",
    "private_vulnerability_reporting",
    "environment_protection",
    "auto_merge",
    "migration"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "scope": {
      "type": "string",
      "const": "repository"
    },
    "default_branch": {
      "type": "string",
      "const": "main"
    },
    "required_status_checks": {
      "type": "object",
      "required": [
        "strict",
        "expected_app_slug",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "strict": {
          "type": "boolean",
          "const": true
        },
        "expected_app_slug": {
          "type": "string",
          "const": "github-actions"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/required_check"
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "required": [
        "added_contexts",
        "retired_contexts"
      ],
      "additionalProperties": false,
      "properties": {
        "added_contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/static_context"
          }
        },
        "retired_contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/static_context"
          }
        }
      }
    },
    "enforce_admins": {
      "type": "boolean",
      "const": true
    },
    "required_pull_request_reviews": {
      "type": "object",
      "required": [
        "dismiss_stale_reviews",
        "require_code_owner_reviews",
        "require_last_push_approval",
        "required_approving_review_count",
        "bypass_pull_request_allowances"
      ],
      "additionalProperties": false,
      "properties": {
        "dismiss_stale_reviews": {
          "type": "boolean",
          "const": true
        },
        "require_code_owner_reviews": {
          "type": "boolean",
          "const": true
        },
        "require_last_push_approval": {
          "type": "boolean",
          "const": true
        },
        "required_approving_review_count": {
          "type": "integer",
          "const": 1
        },
        "bypass_pull_request_allowances": {
          "$ref": "#/$defs/no_bypass_actors"
        }
      }
    },
    "required_conversation_resolution": {
      "type": "boolean",
      "const": true
    },
    "allow_force_pushes": {
      "type": "boolean",
      "const": false
    },
    "allow_deletions": {
      "type": "boolean",
      "const": false
    },
    "independent_review": {
      "type": "object",
      "required": [
        "reviewer_candidate",
        "prevent_self_review"
      ],
      "additionalProperties": false,
      "properties": {
        "reviewer_candidate": {
          "type": "string",
          "const": "guguce-google"
        },
        "prevent_self_review": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "private_vulnerability_reporting": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "environment_protection": {
      "type": "object",
      "required": [
        "existing_environments_only",
        "create_missing_environments",
        "required_reviewer",
        "prevent_self_review"
      ],
      "additionalProperties": false,
      "properties": {
        "existing_environments_only": {
          "type": "boolean",
          "const": true
        },
        "create_missing_environments": {
          "type": "boolean",
          "const": false
        },
        "required_reviewer": {
          "type": "string",
          "const": "guguce-google"
        },
        "prevent_self_review": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "auto_merge": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "const": false
        }
      }
    }
  },
  "$defs": {
    "empty_actor_list": {
      "type": "array",
      "maxItems": 0
    },
    "no_bypass_actors": {
      "type": "object",
      "required": [
        "users",
        "teams",
        "apps"
      ],
      "additionalProperties": false,
      "properties": {
        "users": {
          "$ref": "#/$defs/empty_actor_list"
        },
        "teams": {
          "$ref": "#/$defs/empty_actor_list"
        },
        "apps": {
          "$ref": "#/$defs/empty_actor_list"
        }
      }
    },
    "static_context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*\\$\\{\\{)[\\u0021-\\u007E](?:[\\u0020-\\u007E]*[\\u0021-\\u007E])?$"
    },
    "required_check": {
      "type": "object",
      "required": [
        "context",
        "workflow",
        "job"
      ],
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/static_context"
        },
        "workflow": {
          "type": "string",
          "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$"
        },
        "job": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,99}$"
        }
      }
    }
  }
}
